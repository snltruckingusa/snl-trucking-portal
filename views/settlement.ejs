<%- include('partials/header', { title: 'Settlement' }) %>
<h1>Weekly Settlement</h1>
<p class="notice">Week: Sunday ~ Saturday (Sun–Sat). Formula: driver pay = (delivered revenue − fuel − insurance $100/day) × applied split. Pay follows delivery — a load counts once it is delivered, whether or not its tickets are confirmed yet. The split follows the tenure ladder (first 3 months 45% → 50% → 55% after 1 year; exempt drivers keep a fixed split). Friday close-out. Settlements are paid 1 week in arrears.<br>
Weekend rule: Saturday/Sunday loads pay the driver 70% of net when the two-week full-attendance condition is met (judged automatically from the load records) and the owner confirms.<br>
Downtime pay (truck in repair etc.) is added in full on top of the split pay — it is not split and not reduced by fuel or insurance.</p>

<div class="card">
  <form method="GET" action="/settlement" class="form-row" style="align-items:end">
    <div><label>Week of (Sun)</label><input type="date" name="week" value="<%= weekStartISO %>"></div>
    <div><button type="submit">View week</button>
      <a class="btn secondary" href="/settlement?week=<%= prevWeek %>">← Prev week</a>
      <a class="btn secondary" href="/settlement?week=<%= nextWeek %>">Next week →</a></div>
  </form>
  <p style="margin-top:10px"><b><%= weekStartISO %> ~ <%= weekEndISO %></b></p>
</div>

<div class="grid">
  <div class="stat"><div class="label">Delivered revenue</div><div class="value"><%= money(totals.revenue) %></div></div>
  <div class="stat"><div class="label">Fuel</div><div class="value"><%= money(totals.fuelCost) %></div></div>
  <div class="stat"><div class="label">Insurance</div><div class="value"><%= money(totals.insurance) %></div></div>
  <div class="stat"><div class="label">Driver pay total</div><div class="value"><%= money(totals.driverPay) %></div></div>
  <% if (isAdmin) { %><div class="stat"><div class="label">Company net</div><div class="value"><%= money(totals.companyNet) %></div></div>
  <div class="stat"><div class="label">Receipts this week</div><div class="value"><%= money(receiptsTotal) %> (<%= receiptsCount %>)</div></div><% } %>
  <div class="stat"><div class="label">Not yet delivered</div><div class="value"><%= pendingCount %></div></div>
  <% if (typeof pendingDetentionCount !== 'undefined' && pendingDetentionCount > 0) { %>
  <div class="stat"><div class="label">Detention claims pending</div><div class="value"><%= pendingDetentionCount %></div></div>
  <% } %>
</div>

<div class="card">
  <div class="table-wrap"><table>
    <tr><th>Driver</th><th class="num">Revenue</th><th class="num">Fuel</th><th class="num">Insurance</th><th class="num">Net</th><th class="num">Driver pay</th><% if (isAdmin) { %><th class="num">Company</th><% } %><th class="num">Miles / Gallons</th><th class="num">MPG</th><th>Status</th><th>Driver confirm</th><th></th></tr>
    <% rows.forEach(function(r){ %>
    <tr class="<%= r.saved && r.saved.status === 'closed' ? 'closed' : '' %>">
      <td><%= r.driver.name %> (#<%= r.driver.truck_number || '' %>)<br><span class="notice"><%= r.daysWorked %> days worked · <%= r.splitPct %>% applied</span>
        <% if (r.fuelStd) { %><br><span class="notice">Fuel standard <%= r.fuelStd.stdGallons %> gal — <% if (r.fuelStd.excessGal >= 0) { %>+<%= r.fuelStd.excessGal %> gal over (<%= money(r.fuelStd.excessCost) %>) · your share <%= money(r.fuelStd.driverShare) %><% } else { %><%= r.fuelStd.excessGal %> gal saved (<%= money(-r.fuelStd.excessCost) %>)<% } %></span><% } %>
      </td>
      <td class="num"><%= money(r.revenue) %><% if (r.prepullCredit > 0) { %><br><span class="notice">incl. prepull +<%= money(r.prepullCredit) %></span><% } %></td>
      <td class="num"><%= money(r.fuelCost) %></td>
      <td class="num"><%= money(r.insurance) %></td>
      <td class="num"><%= money(r.net) %></td>
      <td class="num"><b><%= money(r.driverPay) %></b>
        <% if (r.weekend && r.weekend.hasWeekend) { %>
        <br><span class="notice">Weekend net <%= money(r.weekend.weekendNet) %> · <%= r.weekend.conditionMet ? 'Condition met' : 'Condition not met' %><% if (r.weekend.conditionMet && !r.weekendApplied) { %> · at 70%: <%= money(r.weekend.adjustedPay) %><% } %></span>
        <% if (r.weekendApplied) { %><br><span class="badge good">Weekend 70% applied</span><% } %>
        <% } %>
        <% if (r.downtime > 0) { %><br><span class="notice">incl. downtime +<%= money(r.downtime) %></span><% } %>
      </td>
      <% if (isAdmin) { %><td class="num"><%= money(r.companyNet) %></td><% } %>
      <td class="num"><%= r.miles %> / <%= r.gallons %></td>
      <td class="num">
        <% if (r.mpg === null) { %>—<% } else { %>
          <%= r.mpg %>
          <% if (r.mpgFlag) { %><br><span class="badge flag">MPG needs improvement</span><% } else { %><br><span class="badge good">Good</span><% } %>
        <% } %>
        <% if (r.mpg2w !== null && r.mpg2w !== undefined) { %><br><span class="notice">2-week avg <%= r.mpg2w %></span><% } %>
      </td>
      <td>
        <% if (r.saved) { %><span class="badge <%= r.saved.status %>"><%= r.saved.status === 'closed' ? 'Closed' : 'Open' %></span><% } else { %><span class="badge open">Not closed</span><% } %>
      </td>
      <td>
        <% var c = (typeof confirms !== 'undefined' && confirms) ? confirms[r.driver.id] : null; %>
        <% if (c && c.confirmed_at) { %><span class="badge good">Confirmed ✓</span><br><span class="notice"><%= new Date(c.confirmed_at).toLocaleString('en-US') %></span><% if (c.note) { %><br><span class="notice">Question: <%= c.note %></span><% } %>
        <% } else if (c && c.note) { %><span class="badge warn">Question asked</span><br><span class="notice"><%= c.note %></span>
        <% } else { %><span class="badge open">Not confirmed</span><% } %>
      </td>
      <td>
        <% if (isAdmin) { %>
          <% if (r.weekend && r.weekend.hasWeekend && r.weekend.conditionMet && !r.weekendApplied && (!r.saved || r.saved.status !== 'closed')) { %>
          <form class="inline" method="POST" action="/settlement/weekend-confirm"><input type="hidden" name="week" value="<%= weekStartISO %>"><input type="hidden" name="driver_id" value="<%= r.driver.id %>"><button class="btn small" type="submit">Confirm weekend 70%</button></form>
          <% } %>
          <% if (r.weekendApplied && (!r.saved || r.saved.status !== 'closed')) { %>
          <form class="inline" method="POST" action="/settlement/weekend-unconfirm"><input type="hidden" name="week" value="<%= weekStartISO %>"><input type="hidden" name="driver_id" value="<%= r.driver.id %>"><button class="btn small secondary" type="submit">Undo weekend</button></form>
          <% } %>
          <% if (!r.saved || r.saved.status !== 'closed') { %>
          <form class="inline" method="POST" action="/settlement/close"><input type="hidden" name="week" value="<%= weekStartISO %>"><input type="hidden" name="driver_id" value="<%= r.driver.id %>"><button class="btn small" type="submit">Close</button></form>
          <% } else { %>
          <form class="inline" method="POST" action="/settlement/reopen"><input type="hidden" name="week" value="<%= weekStartISO %>"><input type="hidden" name="driver_id" value="<%= r.driver.id %>"><button class="btn small secondary" type="submit">Reopen</button></form>
          <% } %>
        <% } %>
      </td>
    </tr>
    <% }) %>
  </table></div>
  <% if (isAdmin) { %>
  <div style="margin-top:12px">
    <form class="inline" method="POST" action="/settlement/close" onsubmit="return confirm('Close the whole week?')">
      <input type="hidden" name="week" value="<%= weekStartISO %>">
      <button type="submit">Close all (Friday close-out)</button>
    </form>
    <form class="inline" method="POST" action="/settlement/reopen" onsubmit="return confirm('Reopen the whole week?')">
      <input type="hidden" name="week" value="<%= weekStartISO %>">
      <button class="btn secondary" type="submit">Reopen all</button>
    </form>
  </div>
  <% } %>
</div>

<% if (scopedDriverId && rows.length) { var me = rows[0]; var mc = (typeof confirms !== 'undefined' && confirms) ? confirms[me.driver.id] : null; %>
<div class="card">
  <h2>Confirm your settlement</h2>
  <% if (mc && mc.confirmed_at) { %>
  <p><span class="badge good">Confirmed ✓</span> You confirmed this week's settlement on <%= new Date(mc.confirmed_at).toLocaleString('en-US') %>. If anything still looks wrong, send a question below — asking a question clears the confirmation until it is settled.</p>
  <% } else { %>
  <p>Please check your loads (detail below), your fuel and your insurance, then confirm. This week's pay: <b><%= money(me.driverPay) %></b> <span class="notice">(revenue <%= money(me.revenue) %> − fuel <%= money(me.fuelCost) %> − insurance <%= money(me.insurance) %>)</span>. Full detail: use "Print / PDF statement" below.</p>
  <form method="POST" action="/settlement/confirm">
    <input type="hidden" name="week" value="<%= weekStartISO %>">
    <button type="submit">Confirm this week's settlement</button>
  </form>
  <% } %>
  <% if (mc && mc.note) { %><p class="notice">Your question: "<%= mc.note %>"</p><% } %>
  <form method="POST" action="/settlement/question" style="margin-top:10px">
    <input type="hidden" name="week" value="<%= weekStartISO %>">
    <div><label>Question about this week's settlement</label><input type="text" name="note" placeholder="e.g. Fuel on 11/25 looks wrong" style="width:100%"></div>
    <div style="margin-top:6px"><button class="btn secondary" type="submit">Send question instead</button></div>
  </form>
</div>
<% } %>

<% if (isAdmin) { %>
<div class="card">
  <h2>Downtime / other pay</h2>
  <p class="notice">Pay a driver in full for days the truck was down (repairs) or for other agreed work. Added on top of the split pay — not split, no fuel or insurance deduction. The entries and reasons print on the driver's statement.</p>
  <% var anyDt = false; rows.forEach(function(r){ (r.downtimeRows || []).forEach(function(e){ anyDt = true; %>
  <p><%= r.driver.name %> · <%= fmtDate(e.pay_date) %> · <b><%= money(e.amount) %></b><% if (e.reason) { %> — <%= e.reason %><% } %>
    <form class="inline" method="POST" action="/settlement/downtime/<%= e.id %>/delete" onsubmit="return confirm('Delete this downtime entry?')"><button class="btn small danger" type="submit">Delete</button></form></p>
  <% }); }); %>
  <% if (!anyDt) { %><p class="notice">No downtime pay this week.</p><% } %>
  <form method="POST" action="/settlement/downtime" class="form-row" style="align-items:end;margin-top:8px">
    <div><label>Driver</label><select name="driver_id"><% rows.forEach(function(r){ %><option value="<%= r.driver.id %>"><%= r.driver.name %></option><% }); %></select></div>
    <div><label>Date</label><input type="date" name="pay_date" value="<%= weekStartISO %>"></div>
    <div><label>Amount $</label><input type="number" name="amount" step="0.01" min="0"></div>
    <div><label>Reason</label><input type="text" name="reason" placeholder="e.g. Truck #101 in repair"></div>
    <div><button type="submit">Add downtime pay</button></div>
  </form>
</div>
<% } %>

<div class="card">
  <h2>Statement detail (confirmed loads only)</h2>
  <% rows.forEach(function(r){ %>
    <h3><%= r.driver.name %> (#<%= r.driver.truck_number || '' %>) <a class="btn small secondary" href="/settlement/statement?week=<%= weekStartISO %>&driver_id=<%= r.driver.id %>" target="_blank">Print / PDF statement</a> <a class="btn small secondary" href="/settlement/monthly?month=<%= weekStartISO.slice(0, 7) %>&driver_id=<%= r.driver.id %>" target="_blank">Monthly summary</a></h3>
        <% if (r.downtimeRows && r.downtimeRows.length) { %><p class="notice" style="margin:4px 0">Downtime / other pay: <% r.downtimeRows.forEach(function(e){ %><%= fmtDate(e.pay_date) %> <%= money(e.amount) %><% if (e.reason) { %> (<%= e.reason %>)<% } %> · <% }); %>— total <b><%= money(r.downtime) %></b>, added in full.</p><% } %>
    <% if (!r.loads.length) { %><p class="notice">No confirmed loads this week.</p><% } else { %>
    <div class="table-wrap"><table>
      <tr><th>Date</th><th>Container</th><th class="num">Rate</th><th class="num">Return</th><th class="num">Prepull</th><th class="num">Reefer</th><th class="num">Detention</th><th class="num">Overweight</th><th class="num">FSC</th><th class="num">Total</th></tr>
      <% r.loads.forEach(function(l){ %>
      <tr>
        <td><%= fmtDate(l.load_date) %></td>
        <td><%= l.container_no || '' %></td>
        <td class="num"><%= money(l.rate) %></td><td class="num"><%= money(l.return_fee) %></td>
        <td class="num"><%= money(l.prepull) %></td>
        <td class="num"><%= money(l.reefer) %></td>
        <td class="num"><%= money(l.detention) %><% if (l.detention_status === 'pending') { %><br><span class="badge warn">Detention pending (not counted)</span><% } else if (l.detention_status === 'rejected') { %><br><span class="badge flag">Detention rejected (not counted)</span><% } %></td>
        <td class="num"><%= money(l.overweight) %></td>
        <td class="num"><%= money(l.fsc) %></td>
        <td class="num"><b><%= money(loadTotal(l)) %></b></td>
      </tr>
      <% }) %>
      <tr>
        <td colspan="2"><b>Total</b></td>
        <td class="num"><b><%= money(r.loads.reduce(function(s,l){ return s + Number(l.rate); }, 0)) %></b></td>
        <td class="num"><b><%= money(r.loads.reduce(function(s,l){ return s + Number(l.return_fee || 0); }, 0)) %></b></td><td class="num"><b><%= money(r.loads.reduce(function(s,l){ return s + Number(l.prepull); }, 0)) %></b></td>
        <td class="num"><b><%= money(r.loads.reduce(function(s,l){ return s + Number(l.reefer); }, 0)) %></b></td>
        <td class="num"><b><%= money(r.loads.reduce(function(s,l){ return s + ((l.detention_status === 'pending' || l.detention_status === 'rejected') ? 0 : Number(l.detention)); }, 0)) %></b></td>
        <td class="num"><b><%= money(r.loads.reduce(function(s,l){ return s + Number(l.overweight); }, 0)) %></b></td>
        <td class="num"><b><%= money(r.loads.reduce(function(s,l){ return s + Number(l.fsc); }, 0)) %></b></td>
        <td class="num"><b><%= money(r.revenue) %></b></td>
      </tr>
    </table></div>
    <% } %>
  <% }) %>
  <p class="notice">Totals match the confirmed revenue above.</p>
</div>
<%- include('partials/footer') %>
