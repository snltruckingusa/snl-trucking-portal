<%- include('partials/header', { title: 'My File' }) %>

<% if (notice) { %><p class="notice" style="border-left:4px solid #2e7d32;padding-left:10px"><%= notice %></p><% } %>

<% if (mode === 'driver') { %>
<h1>My File</h1>
<p class="notice">Your information, your documents, your training — all in one place. Keep it current: when something changes, update it here.</p>

<div class="card">
  <h2>1 · Profile</h2>
  <p><b><%= driver.name %></b> · Truck #<%= driver.truck_number || '' %><% if (driver.hire_date) { %> · Hired <%= fmtDate(driver.hire_date) %><% } %></p>
  <% if (pendingChange) { %>
    <p class="notice"><span class="badge warn">Waiting for owner review</span> You sent changes on <%= fmtDate(pendingChange.created_at) %>. They take effect when the owner confirms them. You can still edit and re-send below.</p>
  <% } %>
  <ul class="check-list">
    <% profileItems.forEach(function(i){ %>
    <li><% if (i.done) { %>✓ <b><%= i.label %></b><% } else { %><span class="badge flag">Missing</span> <%= i.label %> — <% if (i.owner) { %><span class="notice">the owner adds this one</span><% } else { %><span class="notice">fill it in below</span><% } %><% } %></li>
    <% }) %>
  </ul>
  <form method="POST" action="/documents/profile">
    <div class="form-row">
      <div><label>Address</label><input type="text" name="address" value="<%= (pendingChange ? pendingChange.address : driver.address) || '' %>" placeholder="1428 Fern Dr, Macon, GA 31210"></div>
      <div><label>Phone</label><input type="text" name="phone" value="<%= (pendingChange ? pendingChange.phone : driver.phone) || '' %>" placeholder="478-228-9531"></div>
    </div>
    <div class="form-row">
      <div><label>Emergency contact — name</label><input type="text" name="emergency_name" value="<%= (pendingChange ? pendingChange.emergency_name : driver.emergency_name) || '' %>"></div>
      <div><label>Emergency contact — phone</label><input type="text" name="emergency_phone" value="<%= (pendingChange ? pendingChange.emergency_phone : driver.emergency_phone) || '' %>"></div>
    </div>
    <div style="margin-top:12px"><button type="submit">Save — send for owner review</button></div>
  </form>
</div>

<div class="card">
  <h2>2 · My Documents</h2>
  <div class="boxlist">
    <% checklist.forEach(function(c){ %>
    <div class="boxitem">
      <div class="bi-main">
        <b><%= c.label %></b> <span class="notice">· <%= c.who === 'Driver' ? 'You provide this' : 'Kept by the company' %></span><br>
        <% if (c.doc && c.doc.status === 'pending') { %>⏳ <span class="badge warn">Waiting for owner review</span> — uploaded <%= fmtDate(c.doc.uploaded_at) %>
        <% } else if (c.doc) { %>✓ On file — <%= fmtDate(c.doc.uploaded_at) %><% if (c.doc.signed_by) { %> <span class="badge ok">Signed</span><% } %><% if (c.doc.expires_on) { %> · valid until <b><%= fmtDate(c.doc.expires_on) %></b><% var xi = expiryInfo(c.doc.expires_on); if (xi) { %> <span class="badge <%= xi.cls %>"><%= xi.label %></span><% } } %>
        <% } else { %><span class="badge flag">Missing</span><% } %>
        <% if (c.forms) { %><br><span class="notice">Blank form — download, fill out, sign, then upload here:</span> <% c.forms.forEach(function(f, i){ %><% if (i) { %> · <% } %><a href="<%= f.href %>" target="_blank" rel="noopener"><%= f.label %></a><% }) %><% } %>
        <% if (c.key === 'contract' && typeof chain !== 'undefined' && chain.length > 1) { %><br><span class="notice">Agreement chain:</span> <% chain.forEach(function(cd, i){ %><% if (i) { %> → <% } %><a href="/documents/<%= cd.id %>/download"><%= fmtDate(cd.uploaded_at) %></a><% if (i === chain.length - 1) { %> <span class="badge ok">current</span><% } %><% }) %><% } %>
      </div>
      <% if (c.who === 'Driver') { %>
      <form class="bi-form" method="POST" action="/documents/upload" enctype="multipart/form-data">
        <input type="hidden" name="category" value="<%= c.key %>">
        <% if (c.doc) { %>
        <div style="border-left:4px solid #b26a00;padding:6px 10px;margin-bottom:8px">
          <span class="badge warn">Already registered</span>
          <a href="/documents/<%= c.doc.id %>/download">View the registered document</a>
          <span class="notice">— <%= c.doc.original_name %> · uploaded <%= fmtDate(c.doc.uploaded_at) %><% if (c.doc.expires_on) { %> · valid until <b><%= fmtDate(c.doc.expires_on) %></b><% } %> · <%= c.doc.status === 'pending' ? 'Pending' : 'On file' %></span><br>
          <span class="notice">Your file already has this document. Only add another one if something changed — tell the owner why:</span><br>
          <label class="notice">Reason for the new upload <input type="text" name="upload_reason" required placeholder="e.g. renewed card, corrected copy"></label>
        </div>
        <% } %>
        <input type="file" name="file" required>
        <% if (c.expires) { %><label class="notice">Expiry date (optional) <input type="date" name="expires_on" title="Expiry date — it is printed on the card; adding it turns on renewal alerts"></label><% } %>
        <button class="btn small" type="submit"><%= c.doc ? 'Upload new' : 'Upload' %></button>
      </form>
      <% } %>
    </div>
    <% }) %>
  </div>
  <% var recByCat = {}; docs.forEach(function(d){ if (!d.is_duplicate && !recByCat[d.category]) recByCat[d.category] = { id: d.id, name: d.original_name, uploaded: fmtDate(d.uploaded_at), expires: d.expires_on ? fmtDate(d.expires_on) : '', status: d.status }; }); %>
  <form method="POST" action="/documents/upload" enctype="multipart/form-data">
    <div class="form-row">
      <div><label>Document type</label><select name="category" id="doc-cat-select">
        <% Object.keys(categories).forEach(function(k){ %><option value="<%= k %>"><%= categories[k] %></option><% }) %>
      </select></div>
      <div><label>File (photo or PDF)</label><input type="file" name="file" required></div>
      <div><label>Expires on</label><input type="date" name="expires_on"></div>
    </div>
    <div id="dup-guard-box" style="display:none;border-left:4px solid #b26a00;padding:8px 10px;margin-top:10px">
      <span class="badge warn">Already registered</span> <span id="dup-guard-text"></span><br>
      <a id="dup-guard-view" href="#">View the registered document</a><br>
      <label style="display:block;margin-top:6px">Why is a new one needed? <input type="text" id="dup-reason" name="upload_reason" placeholder="e.g. renewed card, corrected copy" style="width:100%"></label>
    </div>
    <div style="margin-top:12px"><button type="submit">Upload</button></div>
  </form>
  <script>
  (function(){
    var OCC = <%- JSON.stringify(recByCat).replace(/</g, '\\u003c') %>;
    var sel = document.getElementById('doc-cat-select');
    var box = document.getElementById('dup-guard-box');
    var txt = document.getElementById('dup-guard-text');
    var view = document.getElementById('dup-guard-view');
    var reason = document.getElementById('dup-reason');
    if (!sel || !box) return;
    function upd(){
      var rec = OCC[sel.value];
      if (rec) {
        box.style.display = '';
        txt.textContent = '— ' + rec.name + ' · uploaded ' + rec.uploaded + (rec.expires ? ' · valid until ' + rec.expires : '') + ' · ' + (rec.status === 'pending' ? 'Pending' : 'On file') + '. Only add another one if something changed.';
        view.href = '/documents/' + rec.id + '/download';
        reason.required = true;
      } else {
        box.style.display = 'none';
        reason.required = false;
        reason.value = '';
      }
    }
    sel.addEventListener('change', upd);
    upd();
  })();
  </script>
  <p class="notice">Set the expiry date for anything that expires — CDL, medical card, TWIC. New uploads are marked <b>Pending</b> until the owner checks them.</p>
  <% if (!docs.length) { %><p class="notice">No documents yet.</p><% } else { %>
  <div class="table-wrap"><table>
    <tr><th>Type</th><th>File</th><th>Uploaded</th><th>Expires</th><th>Status</th><th></th></tr>
    <% docs.forEach(function(doc){ %>
    <tr>
      <td><%= categories[doc.category] || doc.category %></td>
      <td><a href="/documents/<%= doc.id %>/download"><%= doc.original_name %></a></td>
      <td><%= fmtDate(doc.uploaded_at) %></td>
      <td><% if (doc.expires_on) { %><%= fmtDate(doc.expires_on) %><% var xi = expiryInfo(doc.expires_on); if (xi) { %> <span class="badge <%= xi.cls %>"><%= xi.label %></span><% } %><% } else { %>—<% } %></td>
      <td><% if (doc.status === 'pending') { %><span class="badge warn">Pending</span><% } else { %>On file<% } %><% if (doc.is_duplicate) { %> <span class="badge">Duplicate</span><% } %><% if (doc.signed_by) { %> <span class="badge ok">Signed</span><% } %></td>
      <td><% if (canSign(doc.category) && (doc.mime_type || '').indexOf('pdf') !== -1 && !doc.signed_by && (doc.original_name || '').indexOf('(signed') === -1) { %><a class="btn small" href="/documents/<%= doc.id %>/sign">Sign</a><% } %></td>
    </tr>
    <% }) %>
  </table></div>
  <% } %>
</div>

<div class="card">
  <h2>3 · Training Records</h2>
  <ul class="check-list">
    <% training.forEach(function(t){ %>
    <li><% if (t.acked_at) { %>✓ <b><%= t.title %></b> — completed <%= fmtDate(t.acked_at) %><% } else { %><span class="notice"><%= t.title %> — not completed yet</span><% } %></li>
    <% }) %>
  </ul>
  <p><a class="btn" href="/safety">Open Safety Training</a></p>
</div>

<div class="card">
  <h2>4 · Company Records</h2>
  <ul class="check-list">
    <li>MVR on file — <% if (companyRecords.mvr) { %><%= fmtDate(companyRecords.mvr) %><% } else { %>not on file yet<% } %></li>
    <li>Drug &amp; alcohol test — <% if (companyRecords.drug_test) { %><%= fmtDate(companyRecords.drug_test) %><% } else { %>not on file yet<% } %></li>
    <li>Clearinghouse query — <% if (companyRecords.clearinghouse) { %><%= fmtDate(companyRecords.clearinghouse) %><% } else { %>not on file yet<% } %></li>
  </ul>
  <p class="notice">These are kept by the company. If one is missing, the owner will take care of it.</p>
</div>

<% } else { %>
<h1>My File — Review &amp; Driver Documents</h1>

<% if (pendingChanges.length || pendingDocs.length) { %>
<div class="card">
  <h2>Waiting for your review</h2>
  <% pendingChanges.forEach(function(pc){ %>
  <div style="border-top:1px solid #eee;padding:10px 0">
    <b>Profile change — <%= pc.driver_name %></b> (#<%= pc.truck_number || '' %>) · sent <%= fmtDate(pc.created_at) %><br>
    Address: <%= pc.address || '—' %> · Phone: <%= pc.phone || '—' %> · Emergency: <%= pc.emergency_name || '—' %> <%= pc.emergency_phone || '' %>
    <div style="margin-top:6px">
      <form class="inline" method="POST" action="/documents/profile-changes/<%= pc.id %>/approve"><button class="btn small" type="submit">Approve</button></form>
      <form class="inline" method="POST" action="/documents/profile-changes/<%= pc.id %>/reject"><button class="btn small danger" type="submit">Reject</button></form>
    </div>
  </div>
  <% }) %>
  <% pendingDocs.forEach(function(doc){ %>
  <div style="border-top:1px solid #eee;padding:10px 0">
    <b>Document — <%= doc.driver_name %></b> (#<%= doc.truck_number || '' %>) · <%= categories[doc.category] || doc.category %> · <a href="/documents/<%= doc.id %>/download"><%= doc.original_name %></a> · uploaded <%= fmtDate(doc.uploaded_at) %><% if (doc.expires_on) { %> · expires <%= fmtDate(doc.expires_on) %><% } %>
    <% if (doc.upload_reason) { %><br><span class="badge warn">Reason for this upload</span> <%= doc.upload_reason %><% } %>
    <div style="margin-top:6px">
      <form class="inline" method="POST" action="/documents/<%= doc.id %>/confirm"><button class="btn small" type="submit">Confirm</button></form>
      <form class="inline" method="POST" action="/documents/<%= doc.id %>/delete" onsubmit="return confirm('Delete this document?')"><button class="btn small danger" type="submit">Delete</button></form>
    </div>
  </div>
  <% }) %>
</div>
<% } %>

<div class="card">
  <form method="GET" action="/documents" class="form-row" style="align-items:end">
    <div><label>Driver</label><select name="driver_id">
      <% drivers.forEach(function(d){ %><option value="<%= d.id %>" <%= driver && String(driver.id) === String(d.id) ? 'selected' : '' %>><%= d.name %> (#<%= d.truck_number || '' %>)</option><% }) %>
    </select></div>
    <div><button type="submit">View</button></div>
  </form>
</div>

<% if (driver) { %>
<div class="card">
  <h2><%= driver.name %> — Upload document</h2>
  <form method="POST" action="/documents/upload" enctype="multipart/form-data">
    <input type="hidden" name="driver_id" value="<%= driver.id %>">
    <div class="form-row">
      <div><label>Document type</label><select name="category">
        <% Object.keys(categories).forEach(function(k){ %><option value="<%= k %>"><%= categories[k] %></option><% }) %>
      </select></div>
      <div><label>File</label><input type="file" name="file" required></div>
      <div><label>Expires on (optional)</label><input type="date" name="expires_on"></div>
    </div>
    <div style="margin-top:12px"><button type="submit">Upload</button></div>
  </form>
</div>

<% if (typeof chain !== 'undefined' && chain.length > 1) { %>
<div class="card">
  <h2>Agreement chain</h2>
  <p><% chain.forEach(function(cd, i){ %><% if (i) { %> → <% } %><a href="/documents/<%= cd.id %>/download"><%= cd.original_name %></a> <span class="notice">(<%= fmtDate(cd.uploaded_at) %>)</span><% if (i === chain.length - 1) { %> <span class="badge ok">current</span><% } %><% }) %></p>
  <p class="notice">Original agreement first, then each amendment in order. The newest is the current record.</p>
</div>
<% } %>
<div class="card">
  <h2>Documents</h2>
  <% if (!docs.length) { %><p class="notice">No documents yet.</p><% } else { %>
  <div class="table-wrap"><table>
    <tr><th>Type</th><th>File</th><th>Uploaded</th><th>Expires</th><th>Status</th><th></th></tr>
    <% docs.forEach(function(doc){ %>
    <tr>
      <td><%= categories[doc.category] || doc.category %></td>
      <td><a href="/documents/<%= doc.id %>/download"><%= doc.original_name %></a></td>
      <td><%= fmtDate(doc.uploaded_at) %></td>
      <td><% if (doc.expires_on) { %><%= fmtDate(doc.expires_on) %><% var xi = expiryInfo(doc.expires_on); if (xi) { %> <span class="badge <%= xi.cls %>"><%= xi.label %></span><% } %><% } else { %>—<% } %></td>
      <td><% if (doc.status === 'pending') { %><span class="badge warn">Pending</span><% } else { %>On file<% } %><% if (doc.is_duplicate) { %> <span class="badge">Duplicate</span><% } %><% if (doc.signed_by) { %> <span class="badge ok">Signed</span><% } %><% if (doc.upload_reason) { %><br><span class="badge warn">Reason</span> <span class="notice"><%= doc.upload_reason %></span><% } %></td>
      <td>
        <% if (canSign(doc.category) && (doc.mime_type || '').indexOf('pdf') !== -1 && !doc.signed_by && (doc.original_name || '').indexOf('(signed') === -1) { %><a class="btn small" href="/documents/<%= doc.id %>/sign">Sign</a><% } %>
        <% if (doc.status === 'pending') { %><form class="inline" method="POST" action="/documents/<%= doc.id %>/confirm"><button class="btn small" type="submit">Confirm</button></form><% } %>
        <form class="inline" method="POST" action="/documents/<%= doc.id %>/duplicate"><button class="btn small" type="submit"><%= doc.is_duplicate ? 'Unmark duplicate' : 'Mark duplicate' %></button></form>
        <form class="inline" method="POST" action="/documents/<%= doc.id %>/delete" onsubmit="return confirm('Delete this document?')"><button class="btn small danger" type="submit">Delete</button></form>
      </td>
    </tr>
    <% }) %>
  </table></div>
  <% } %>
</div>
<% } else { %>
<p class="notice">Select a driver to view their documents.</p>
<% } %>
<% } %>
<%- include('partials/footer') %>
