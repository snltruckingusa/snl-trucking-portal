<%- include('partials/header', { title: 'Documents' }) %>
<h1>Driver Documents</h1>
<p class="notice">Keep each driver's MVR, medical card, CDL, registration, and contracts here.</p>

<div class="card">
  <form method="GET" action="/documents" class="form-row" style="align-items:end">
    <% if (isAdmin) { %>
    <div><label>Driver</label><select name="driver_id">
      <% drivers.forEach(function(d){ %><option value="<%= d.id %>" <%= driver && String(driver.id) === String(d.id) ? 'selected' : '' %>><%= d.name %> (#<%= d.truck_number || '' %>)</option><% }) %>
    </select></div>
    <% } %>
    <div><button type="submit">View</button></div>
  </form>
</div>

<% if (driver) { %>
<div class="card">
  <h2><%= driver.name %> — Upload document</h2>
  <form method="POST" action="/documents/upload" enctype="multipart/form-data">
    <input type="hidden" name="driver_id" value="<%= driver.id %>">
    <div class="form-row">
      <div><label>Category</label><select name="category">
        <% Object.keys(categories).forEach(function(k){ %><option value="<%= k %>"><%= categories[k] %></option><% }) %>
      </select></div>
      <div><label>File</label><input type="file" name="file" required></div>
      <div><label>Expires on (optional)</label><input type="date" name="expires_on"></div>
    </div>
    <div style="margin-top:12px"><button type="submit">Upload</button></div>
  </form>
</div>

<div class="card">
  <h2>Documents</h2>
  <% if (!docs.length) { %><p class="notice">No documents yet.</p><% } else { %>
  <div class="table-wrap"><table>
    <tr><th>Category</th><th>File</th><th>Uploaded</th><th>Expires</th><th></th></tr>
    <% docs.forEach(function(doc){ %>
    <tr>
      <td><%= categories[doc.category] || doc.category %></td>
      <td><a href="/documents/<%= doc.id %>/download"><%= doc.original_name %></a></td>
      <td><%= fmtDate(doc.uploaded_at) %></td>
      <td><% if (doc.expires_on) { %><%= fmtDate(doc.expires_on) %><% if (expiringWithin(doc.expires_on, 30)) { %> <span class="badge warn">Soon</span><% } %><% } else { %>—<% } %></td>
      <td>
        <form class="inline" method="POST" action="/documents/<%= doc.id %>/delete" onsubmit="return confirm('Delete this document?')"><button class="btn small danger" type="submit">Delete</button></form>
      </td>
    </tr>
    <% }) %>
  </table></div>
  <% } %>
</div>
<% } else { %>
<p class="notice">Select a driver to view their documents.</p>
<% } %>
<%- include('partials/footer') %>
