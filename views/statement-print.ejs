<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Driver Statement — <%= r.driver.name %> — <%= weekStartISO %></title>
<style>
  body { font-family: Arial, Helvetica, sans-serif; color:#111; margin:24px; font-size:13px; }
  h1 { font-size:20px; margin:0 0 2px; }
  h2 { font-size:15px; margin:18px 0 6px; }
  .sub { color:#444; margin:2px 0; }
  table { border-collapse:collapse; width:100%; margin-top:8px; }
  th, td { border:1px solid #bbb; padding:5px 7px; text-align:left; }
  th { background:#f0f0f0; }
  td.num, th.num { text-align:right; }
  .summary { margin-top:16px; width:340px; }
  .summary td { border:none; padding:3px 7px; }
  .summary tr.total td { border-top:2px solid #111; font-size:16px; font-weight:700; }
  .note { color:#555; font-size:12px; margin-top:14px; }
  .letterhead { display:flex; justify-content:space-between; align-items:flex-start; border-bottom:2px solid #111; padding-bottom:8px; }
  .co-name { font-size:22px; font-weight:700; }
  .co div { margin:1px 0; }
  .doc-title { font-size:28px; font-weight:700; }
  .meta { display:flex; justify-content:space-between; align-items:flex-start; margin-top:10px; gap:16px; }
  .driver-block p { margin:3px 0; }
  .info-box { width:320px; margin-top:0; }
  .info-box td { padding:4px 7px; }
  .toolbar { margin-bottom:16px; }
  .toolbar button, .toolbar a { font-size:14px; padding:8px 14px; margin-right:8px; }
  @media print {
    .no-print { display:none; }
    body { margin:0; }
    @page { margin: 0.6in; }
  }
</style>
</head>
<body>
<div class="toolbar no-print">
  <button onclick="window.print()">Print / Save as PDF</button>
  <a href="/settlement?week=<%= weekStartISO %>">Back to settlement</a>
</div>

<% const fmtUS = d => { if (!d) return ''; const x = new Date(String(d).slice(0, 10) + 'T00:00:00'); const p = n => String(n).padStart(2, '0'); return p(x.getMonth() + 1) + '/' + p(x.getDate()) + '/' + x.getFullYear(); }; %>
<div class="letterhead">
  <div class="co">
    <div class="co-name">S&amp;L Trucking LLC</div>
    <div>197 Berwick Lakes Blvd</div>
    <div>Pooler GA 31322</div>
    <div>Tel) 213-503-5668</div>
  </div>
  <div class="doc-title">Statement</div>
</div>
<div class="meta">
  <div class="driver-block">
    <p>Driver's Name: <b><%= r.driver.name %></b></p>
    <p>Address: <%= r.driver.address || '' %></p>
    <p>Tel) <%= r.driver.phone || '' %></p>
    <p>Truck # <%= r.driver.truck_number || '' %></p>
  </div>
  <table class="info-box">
    <tr><td>Statement Date:</td><td><%= fmtUS(generatedOn) %></td></tr>
    <tr><td>Period</td><td>From <%= fmtUS(weekStartISO) %> &nbsp; To <%= fmtUS(weekEndISO) %></td></tr>
    <tr><td>Method</td><td>Zelle</td></tr>
    <tr><td>Pay Day</td><td><%= fmtUS(payDayISO) %></td></tr>
  </table>
</div>
<p class="sub">Status: <%= r.saved ? (r.saved.status === 'closed' ? 'Closed' : 'Open') : 'Not closed' %></p>

<h2>Loads (confirmed only)</h2>
<% if (!r.loads.length) { %>
<p>No confirmed loads this week.</p>
<% } else { %>
<table>
  <tr><th>Date</th><th>Container</th><th>Delivery</th><th class="num">Rate</th><th class="num">Return</th><th class="num">Prepull</th><th class="num">Reefer</th><th class="num">Detention</th><th class="num">Overweight</th><th class="num">FSC</th><th class="num">Total</th></tr>
  <% r.loads.forEach(function(l){ %>
  <tr>
    <td><%= fmtDate(l.load_date) %></td>
    <td><%= l.container_no || '' %></td>
    <td><%= l.delivery || '' %></td>
    <td class="num"><%= money(l.rate) %></td><td class="num"><%= money(l.return_fee) %></td>
    <td class="num"><%= money(l.prepull) %></td>
    <td class="num"><%= money(l.reefer) %></td>
    <td class="num"><%= money(l.detention) %><% if (l.detention_status === 'pending') { %><br><small>pending (not counted)</small><% } else if (l.detention_status === 'rejected') { %><br><small>rejected (not counted)</small><% } %></td>
    <td class="num"><%= money(l.overweight) %></td>
    <td class="num"><%= money(l.fsc) %></td>
    <td class="num"><b><%= money(loadTotal(l)) %></b></td>
  </tr>
  <% }) %>
  <tr>
    <td colspan="3"><b>Total</b></td>
    <td class="num"><b><%= money(r.loads.reduce(function(s,l){ return s + Number(l.rate); }, 0)) %></b></td>
    <td class="num"><b><%= money(r.loads.reduce(function(s,l){ return s + Number(l.return_fee || 0); }, 0)) %></b></td><td class="num"><b><%= money(r.loads.reduce(function(s,l){ return s + Number(l.prepull); }, 0)) %></b></td>
    <td class="num"><b><%= money(r.loads.reduce(function(s,l){ return s + Number(l.reefer); }, 0)) %></b></td>
    <td class="num"><b><%= money(r.loads.reduce(function(s,l){ return s + ((l.detention_status === 'pending' || l.detention_status === 'rejected') ? 0 : Number(l.detention)); }, 0)) %></b></td>
    <td class="num"><b><%= money(r.loads.reduce(function(s,l){ return s + Number(l.overweight); }, 0)) %></b></td>
    <td class="num"><b><%= money(r.loads.reduce(function(s,l){ return s + Number(l.fsc); }, 0)) %></b></td>
    <td class="num"><b><%= money(r.revenue) %></b></td>
  </tr>
</table>
<% } %>

<% if (typeof pendingLoads !== 'undefined' && pendingLoads.length) { %>
<h2>Loads not yet counted (not yet delivered)</h2>
<table>
  <tr><th>Date</th><th>Container</th><th>Delivery</th><th class="num">Total</th><th>Status</th></tr>
  <% pendingLoads.forEach(function(l){ %>
  <tr>
    <td><%= fmtDate(l.load_date) %></td>
    <td><%= l.container_no || '' %></td>
    <td><%= l.delivery || '' %></td>
    <td class="num"><%= money(loadTotal(l)) %></td>
    <td>Not counted yet</td>
  </tr>
  <% }) %>
</table>
<p class="note">These loads are registered for this week but are not delivered yet, so they are not in the totals below. A load is counted once it is delivered.</p>
<% } %>

<table class="summary">
  <tr><td>Revenue</td><td class="num"><%= money(r.revenue) %></td></tr>
  <% if (r.prepullCredit > 0) { %><tr><td>&nbsp;&nbsp;of which prepull work (approved)</td><td class="num"><%= money(r.prepullCredit) %></td></tr><% } %>
  <tr><td>Fuel (<%= r.gallons %> gal)</td><td class="num">− <%= money(r.fuelCost) %></td></tr>
  <tr><td>Insurance ($100 × <%= r.daysWorked %> days)</td><td class="num">− <%= money(r.insurance) %></td></tr>
  <tr><td>Net</td><td class="num"><%= money(r.net) %></td></tr>
  <tr><td>Your split</td><td class="num"><%= r.splitPct %>%</td></tr>
  <% if (r.weekendApplied) { %><tr><td>Weekend rule</td><td class="num">70% applied (weekend net <%= money(r.weekend.weekendNet) %>)</td></tr><% } %>
    <% if (r.downtime) { %><tr><td>Downtime pay (added in full)</td><td class="num">+ <%= money(r.downtime) %></td></tr><% } %>
  <tr class="total"><td>Driver pay</td><td class="num"><%= money(r.driverPay) %></td></tr>
</table>

<% if (typeof fuelEntries !== 'undefined' && fuelEntries.length) { %>
<h2>Fuel purchases counted this week</h2>
<table>
  <tr><th>Date</th><th class="num">Gallons</th><th class="num">TCS $/gal</th><th class="num">Amount</th></tr>
  <% fuelEntries.forEach(function(f){ %>
  <tr>
    <td><%= fmtDate(f.fuel_date) %></td>
    <td class="num"><%= f.gallons %></td>
    <td class="num">$<%= Number(f.tcs_price).toFixed(4) %></td>
    <td class="num"><%= money(f.cost) %></td>
  </tr>
  <% }) %>
  <tr><td><b>Total</b></td><td class="num"><b><%= r.gallons %></b></td><td></td><td class="num"><b><%= money(r.fuelCost) %></b></td></tr>
</table>
<% } %>
<% if (r.fuelStd) { %>
<p class="note">Fuel standard for your lanes: <%= r.fuelStd.stdGallons %> gal. You used <%= r.fuelStd.excessGal >= 0 ? r.fuelStd.excessGal + ' gal over' : Math.abs(r.fuelStd.excessGal) + ' gal under' %> the standard<% if (r.fuelStd.excessGal >= 0) { %> (<%= money(r.fuelStd.excessCost) %>; your share <%= money(r.fuelStd.driverShare) %>)<% } else { %> (saved <%= money(-r.fuelStd.excessCost) %>)<% } %>. Miles: <%= r.miles %> · MPG: <%= r.mpg === null ? '—' : r.mpg %><% if (r.mpg2w !== null && r.mpg2w !== undefined) { %> · 2-week avg MPG: <%= r.mpg2w %><% } %>.</p>
<% } %>
<% if (r.downtimeRows && r.downtimeRows.length) { %><p class="note">Downtime pay: <% r.downtimeRows.forEach(function(e){ %><%= fmtDate(e.pay_date) %> — <%= money(e.amount) %><% if (e.reason) { %> (<%= e.reason %>)<% } %>; <% }); %></p><% } %>
<p class="note">This statement covers confirmed loads only. Settlements are paid 1 week in arrears. Questions: contact the owner.</p>
</body>
</html>
