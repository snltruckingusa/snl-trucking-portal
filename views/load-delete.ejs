<%- include('partials/header', { title: 'Delete load' }) %>
<h1>Delete load</h1>
<div class="card">
  <p>Delete this load? It will also disappear from settlements.</p>
  <p>
    <b><%= fmtDate(load.load_date) %></b> · <%= load.driver_name %> ·
    <%= load.pickup || '' %> → <%= load.delivery || '' %> ·
    <b><%= money(loadTotal(load)) %></b> · <%= load.miles %> mi ·
    <span class="badge <%= load.status %>"><%= load.status === 'confirmed' ? 'Confirmed' : 'Pending' %></span>
  </p>
  <form class="inline" method="POST" action="/loads/<%= load.id %>/delete">
    <button class="btn danger" type="submit">Delete</button>
  </form>
  <a class="btn secondary" href="/loads">Cancel</a>
</div>
<%- include('partials/footer') %>
