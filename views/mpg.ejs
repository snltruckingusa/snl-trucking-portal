<%- include('partials/header', { title: 'MPG' }) %>
<h1>MPG</h1>
<p class="notice">MPG = miles ÷ gallons (confirmed load miles for the week ÷ fuel gallons). <b>Below 6.0 is flagged "MPG needs improvement."</b> Good ~7.2–7.3, poor ~6.2–6.3.<br>
MPG = miles ÷ gallons for the week. Below 6.0 is flagged as needing fuel-economy improvement.</p>

<% table.forEach(function(w){ %>
<div class="card">
  <h2>Week of <%= w.weekStartISO %></h2>
  <div class="table-wrap"><table>
    <tr><th>Driver</th><th class="num">Miles</th><th class="num">Gallons</th><th class="num">MPG</th><th>Result</th></tr>
    <% w.rows.forEach(function(r){ %>
    <tr>
      <td><%= r.driver.name %> (#<%= r.driver.truck_number || '' %>)</td>
      <td class="num"><%= r.miles %></td>
      <td class="num"><%= r.gallons %></td>
      <td class="num"><%= r.mpg === null ? '—' : r.mpg %></td>
      <td>
        <% if (r.mpg === null) { %><span class="notice">No data</span>
        <% } else if (r.mpgFlag) { %><span class="badge flag">MPG needs improvement</span>
        <% } else { %><span class="badge good">Good</span><% } %>
      </td>
    </tr>
    <% }) %>
  </table></div>
</div>
<% }) %>
<%- include('partials/footer') %>
