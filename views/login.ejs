<%- include('partials/header', { title: 'Login', isAdmin: false }) %>
<div class="card login-card">
  <h1>로그인 / Login</h1>
  <p class="notice">S&amp;L Trucking 정산 포털 — Settlement Portal</p>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="POST" action="/login">
    <label>아이디 / Username</label>
    <input name="username" required autocomplete="username">
    <label>비밀번호 / Password</label>
    <input type="password" name="password" required autocomplete="current-password">
    <div style="margin-top:16px"><button type="submit">로그인 / Log in</button></div>
  </form>
  <p class="notice" style="margin-top:14px">기사님은 관리자가 만들어 드린 계정으로 로그인하세요. 비밀번호를 잊으셨으면 관리자에게 문의하세요.</p>
</div>
<%- include('partials/footer') %>
