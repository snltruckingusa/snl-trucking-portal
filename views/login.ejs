<%- include('partials/header', { title: 'Login', isAdmin: false }) %>
<div class="card login-card">
  <h1>Login</h1>
  <p class="notice">S&amp;L Trucking Settlement Portal</p>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="POST" action="/login">
    <label>Username</label>
    <input name="username" required autocomplete="username">
    <label>Password</label>
    <input type="password" name="password" required autocomplete="current-password">
    <div style="margin-top:16px"><button type="submit">Log in</button></div>
  </form>
  <p class="notice" style="margin-top:14px">Drivers: please log in with the account the admin created for you. If you forgot your password, contact the admin.</p>
</div>
<%- include('partials/footer') %>
