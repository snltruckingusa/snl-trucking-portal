<%- include('partials/header', { title: 'Change Password' }) %>
<div class="card login-card">
  <h1>비밀번호 변경 / Change Password</h1>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <% if (mustChange) { %><div class="alert">처음 로그인하셨습니다. 비밀번호를 변경해 주세요.<br>First login — please change your password.</div><% } %>
  <form method="POST" action="/change-password">
    <label>현재 비밀번호 / Current password</label>
    <input type="password" name="current" required autocomplete="current-password">
    <label>새 비밀번호 (8자 이상) / New password (8+ chars)</label>
    <input type="password" name="password" required autocomplete="new-password">
    <label>새 비밀번호 확인 / Confirm new password</label>
    <input type="password" name="confirm" required autocomplete="new-password">
    <div style="margin-top:16px"><button type="submit">변경 / Change</button></div>
  </form>
</div>
<%- include('partials/footer') %>
