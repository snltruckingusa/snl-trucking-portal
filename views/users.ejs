<%- include('partials/header', { title: 'Users' }) %>
<h1>User Accounts</h1>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<% if (typeof notice !== 'undefined' && notice) { %><div class="alert ok"><%= notice %></div><% } %>

<div class="card">
  <h2>Create account</h2>
  <p class="notice">Create one account per driver. The admin sets the password and gives it to the driver. The driver must change it at first login.</p>
  <form method="POST" action="/users">
    <div class="form-row">
      <div><label>Username</label><input name="username" required></div>
      <div><label>Password (8+ chars)</label><input type="password" name="password" required></div>
      <div><label>Role</label><select name="role"><option value="driver">Driver</option><option value="mechanic">Mechanic</option><option value="admin">Admin</option></select></div>
      <div><label>Linked driver</label><select name="driver_id"><option value="">— (for admin)</option>
        <% drivers.forEach(function(d){ %><option value="<%= d.id %>"><%= d.name %> (#<%= d.truck_number || '' %>)</option><% }) %>
      </select></div>
    </div>
    <div style="margin-top:12px"><button type="submit">Create</button></div>
  </form>
</div>

<div class="card">
  <div class="table-wrap"><table>
    <tr><th>Username</th><th>Role</th><th>Linked driver</th><th></th></tr>
    <% users.forEach(function(u){ %>
    <tr>
      <td><%= u.username %></td>
      <td><%= u.role %></td>
      <td><%= u.driver_name || '—' %></td>
      <td>
        <form class="inline" method="POST" action="/users/<%= u.id %>/reset" onsubmit="return confirm('Reset this account\'s password to a temporary password?')"><button class="btn small secondary" type="submit">Reset password</button></form>
        <form class="inline" method="POST" action="/users/<%= u.id %>/delete" onsubmit="return confirm('Really delete this account?')"><button class="btn small danger" type="submit">Delete</button></form>
      </td>
    </tr>
    <% }) %>
  </table></div>
</div>
<%- include('partials/footer') %>
