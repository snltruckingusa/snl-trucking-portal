<%- include('partials/header', { title: 'Drivers' }) %>
<h1>Drivers</h1>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>

<div class="card">
  <h2>Add driver</h2>
  <form method="POST" action="/drivers">
    <div class="form-row">
      <div><label>Name</label><input name="name" required></div>
      <div><label>Truck #</label><input name="truck_number" placeholder="100"></div>
      <div><label>Pay split %</label><input name="pay_split" type="number" step="0.01" value="50"></div>
      <div><label>Hire date</label><input name="hire_date" type="date"></div>
      <div><label style="display:inline"><input type="checkbox" name="ladder_exempt"> Ladder exempt (fixed split from day one)</label></div>
    </div>
    <div style="margin-top:12px"><button type="submit">Add</button></div>
  </form>
  <p class="notice">Tenure ladder: first 3 months after hire 45% → 50% → 55% after 1 year (applied automatically when a hire date is set). If the exempt box is checked, the split stays at the entered rate.</p>
</div>

<div class="card">
  <div class="table-wrap"><table>
    <tr><th>Name</th><th>Truck</th><th>Pay split % (set / current)</th><th>Hire date / Exempt</th><th>Status</th><th>Edit</th><th></th></tr>
    <% drivers.forEach(function(d){ %>
    <tr>
      <form method="POST" action="/drivers/<%= d.id %>/edit">
        <td><input name="name" value="<%= d.name %>" required></td>
        <td><input name="truck_number" value="<%= d.truck_number || '' %>"></td>
        <td><input name="pay_split" type="number" step="0.01" value="<%= d.pay_split %>" style="width:70px"> / <b><%= d.current_split %>%</b></td>
        <td><input name="hire_date" type="date" value="<%= d.hire_date ? fmtDate(d.hire_date) : '' %>">
          <label style="display:inline"><input type="checkbox" name="ladder_exempt" <%= d.ladder_exempt ? 'checked' : '' %>> Exempt</label></td>
        <td><label style="display:inline"><input type="checkbox" name="active" <%= d.active ? 'checked' : '' %>> Active</label></td>
        <td><button class="btn small" type="submit">Save</button></td>
      </form>
      <td>
        <form class="inline" method="POST" action="/drivers/<%= d.id %>/delete" onsubmit="return confirm('Really delete? A driver with load, fuel, or settlement records cannot be deleted.')">
          <button class="btn small danger" type="submit">Delete</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </table></div>
  <p class="notice">A driver can only be deleted if they have no load, fuel, or settlement records. Deactivate drivers who have records.</p>
</div>
<%- include('partials/footer') %>
