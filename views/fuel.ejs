<%- include('partials/header', { title: 'Fuel' }) %>
<h1>연료 / Fuel</h1>
<p class="notice">비용은 <b>갤런 × TCS 할인가</b>로 계산됩니다. Cost = gallons × TCS discounted price/gal.</p>

<div class="card">
  <h2>연료 입력 / Add fuel</h2>
  <form method="POST" action="/fuel">
    <div class="form-row">
      <% if (isAdmin) { %>
      <div><label>기사 / Driver</label><select name="driver_id" required>
        <% drivers.forEach(function(d){ %><option value="<%= d.id %>"><%= d.name %> (#<%= d.truck_number || '' %>)</option><% }) %>
      </select></div>
      <% } else { %>
      <input type="hidden" name="driver_id" value="<%= scopedDriverId %>">
      <% } %>
      <div><label>날짜 / Date</label><input type="date" name="fuel_date" required value="<%= new Date().toISOString().slice(0,10) %>"></div>
      <div><label>갤런 / Gallons</label><input name="gallons" type="number" step="0.01" required placeholder="100"></div>
      <div><label>펌프 가격 / Pump $/gal</label><input name="pump_price" type="number" step="0.001" placeholder="3.899"></div>
      <div><label>TCS 할인가 / TCS $/gal</label><input name="tcs_price" type="number" step="0.001" required placeholder="3.499"></div>
    </div>
    <div style="margin-top:12px"><button type="submit">저장 / Save fuel</button></div>
  </form>
</div>

<div class="card">
  <h2>연료 목록 / Fuel list</h2>
  <form method="GET" action="/fuel">
    <div class="form-row">
      <div><label>부터 / From</label><input type="date" name="from" value="<%= filters.from %>"></div>
      <div><label>까지 / To</label><input type="date" name="to" value="<%= filters.to %>"></div>
      <% if (isAdmin) { %>
      <div><label>기사 / Driver</label><select name="driver_id"><option value="">전체 / All</option>
        <% drivers.forEach(function(d){ %><option value="<%= d.id %>" <%= String(filters.driver_id) === String(d.id) ? 'selected' : '' %>><%= d.name %></option><% }) %>
      </select></div>
      <% } %>
    </div>
    <div style="margin-top:12px"><button type="submit">조회 / Filter</button></div>
  </form>
  <div class="table-wrap" style="margin-top:12px"><table>
    <tr><th>날짜</th><th>기사</th><th class="num">갤런</th><th class="num">펌프 $/gal</th><th class="num">TCS $/gal</th><th class="num">비용 / Cost</th><th></th></tr>
    <% fuel.forEach(function(f){ %>
    <tr>
      <td><%= fmtDate(f.fuel_date) %></td>
      <td><%= f.driver_name %> (#<%= f.truck_number || '' %>)</td>
      <td class="num"><%= f.gallons %></td>
      <td class="num"><%= f.pump_price %></td>
      <td class="num"><%= f.tcs_price %></td>
      <td class="num"><%= money(f.cost) %></td>
      <td>
        <form class="inline" method="POST" action="/fuel/<%= f.id %>/delete" onsubmit="return confirm('삭제할까요?')"><button class="btn small danger" type="submit">삭제</button></form>
      </td>
    </tr>
    <% }) %>
  </table></div>
  <% if (!fuel.length) { %><p class="notice">기록이 없습니다. No fuel records.</p><% } %>
</div>
<%- include('partials/footer') %>
