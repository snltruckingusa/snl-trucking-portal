<%- include('partials/header', { title: 'Dashboard' }) %>
<h1>Dashboard</h1>

<% if (isAdmin) { %>
  <div class="card">
    <h2>To check today (<%= today %>)</h2>

    <h3>Pending loads</h3>
    <% if (!pending.length) { %><p class="notice">No pending loads.</p><% } else { %>
    <div class="table-wrap"><table>
      <tr><th>Date</th><th>Driver</th><th>Container</th><th>Pickup → Delivery</th><th>Amount</th><th></th></tr>
      <% pending.forEach(function(l){ %>
      <tr>
        <td><%= fmtDate(l.load_date) %></td>
        <td><%= l.driver_name %></td>
        <td><%= l.container_no || '' %></td>
        <td><%= l.pickup || '' %> → <%= l.delivery || '' %></td>
        <td class="num"><%= money(loadTotal(l)) %></td>
        <td><a class="btn small" href="/loads?status=pending">Review</a></td>
      </tr>
      <% }) %>
    </table></div>
    <% } %>

    <h3>No load entered today</h3>
    <% if (!idleDrivers.length) { %><p class="notice">All drivers have a load today.</p><% } else { %>
    <ul class="check-list">
      <% idleDrivers.forEach(function(d){ %><li><%= d.name %> (#<%= d.truck_number || '' %>)</li><% }) %>
    </ul>
    <% } %>

    <h3>Documents expiring within 30 days</h3>
    <% if (!expiringDocs.length) { %><p class="notice">None.</p><% } else { %>
    <ul class="check-list">
      <% expiringDocs.forEach(function(doc){ %>
      <li><%= doc.driver_name %> — <%= doc.original_name %> <span class="badge warn">Expires <%= fmtDate(doc.expires_on) %></span></li>
      <% }) %>
    </ul>
    <% } %>

    <h3>Missing evidence (last 3 weeks)</h3>
    <% if (typeof missingEvidence === 'undefined' || !missingEvidence.length) { %><p class="notice">None.</p><% } else { %>
    <ul class="check-list">
      <% missingEvidence.forEach(function(x){ %>
      <li><%= x.driver_name %> — <%= fmtDate(x.load.load_date) %> · <%= x.load.delivery || '' %> (<%= x.load.container_no || '—' %>): missing <%= x.missing.map(function(s){ return stageLabels[s]; }).join(', ') %></li>
      <% }) %>
    </ul>
    <% } %>

    <h3>Low MPG — latest settlement (MPG &lt; 6.0)</h3>
    <% if (!mpgFlags.length) { %><p class="notice">None.</p><% } else { %>
    <ul class="check-list">
      <% mpgFlags.forEach(function(s){ %>
      <li><%= s.driver_name %> — week of <%= fmtDate(s.week_start) %> · MPG <%= s.mpg %> <span class="badge flag">MPG needs improvement</span></li>
      <% }) %>
    </ul>
    <% } %>
  </div>

  <div class="grid">
    <div class="stat"><div class="label">Confirmed revenue this week (<%= weekStartISO %> ~ <%= weekEndISO %>)</div><div class="value"><%= money(summary.revenue) %></div></div>
    <div class="stat"><div class="label">Fuel this week</div><div class="value"><%= money(fuelCost) %></div></div>
    <div class="stat"><div class="label">Receipts this week (PierLink)</div><div class="value"><%= money(receiptsTotal) %></div></div>
    <div class="stat"><div class="label">Pending entries</div><div class="value"><%= summary.pending_n %></div></div>
  </div>

  <div class="card">
    <h2>Drivers</h2>
    <div class="table-wrap"><table>
      <tr><th>Name</th><th>Truck</th><th>Pay split</th><th>Status</th></tr>
      <% drivers.forEach(function(d){ %>
      <tr><td><%= d.name %></td><td>#<%= d.truck_number || '' %></td><td class="num"><%= d.pay_split %>%</td><td><%= d.active ? 'Active' : 'Inactive' %></td></tr>
      <% }) %>
    </table></div>
    <p style="margin-top:10px"><a class="btn" href="/settlement">View this week's settlement</a></p>
  </div>

<% } else { %>
  <style>
    .menu-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:4px; }
    .menu-tile { display:flex; flex-direction:column; gap:2px; padding:16px 14px; border:1px solid #d8d8d8; border-radius:12px; background:#fff; text-decoration:none; color:inherit; }
    .menu-tile:active { background:#f2f6ff; }
    .menu-tile .mt-icon { font-size:26px; line-height:1.1; }
    .menu-tile .mt-title { font-weight:700; font-size:17px; }
    .menu-tile .mt-sub { font-size:12.5px; color:#666; }
    .menu-tile.wide { grid-column:1 / -1; flex-direction:row; align-items:center; gap:14px; }
    .menu-tile .mt-badge { margin-left:auto; }
  </style>
  <div class="card">
    <h2><%= driver.name %> (#<%= driver.truck_number || '' %>) — Today (<%= today %>)</h2>

    <% if (pendingCount > 0) { %><p><span class="badge warn"><%= pendingCount %> pending</span> <span class="notice">Some loads are waiting for admin review.</span></p><% } %>
    <% if (expiringCount > 0) { %><p><span class="badge warn"><%= expiringCount %> documents expiring soon</span> <span class="notice"><a href="/documents">Check documents</a></span></p><% } %>

    <% if (!todayLoads.length) { %>
      <p class="notice">No loads yet today.</p>
      <p><a class="btn" href="/loads">Add from dispatch or ticket photo</a></p>
    <% } else { %>
      <% todayLoads.forEach(function(l){ %>
      <div class="load-card">
        <div class="lc-meta">Container: <b><%= l.container_no || '—' %></b>
          <span class="badge <%= l.status %>"><%= l.status === 'confirmed' ? 'Confirmed' : 'Pending' %></span>
          <span class="badge progress"><%= PROGRESS_LABELS[l.progress] || l.progress %></span>
        </div>
        <div class="lc-route"><%= l.pickup || '?' %> → <%= l.delivery || '?' %></div>
        <% if (l.appointment) { %><div class="lc-meta">Appointment: <%= fmtDate(l.appointment) %> <%= new Date(l.appointment).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></div><% } %>
        <% if (l.bol_ref) { %><div class="lc-meta">BOL / Ref: <%= l.bol_ref %></div><% } %>
        <% if (l.notes) { %><div class="lc-meta"><%= l.notes %></div><% } %>
        <% if (l.progress !== 'returned') { %>
        <form method="POST" action="/loads/<%= l.id %>/progress" enctype="multipart/form-data" style="margin-top:8px">
          <div><label><%= l.progress === 'scheduled' ? 'Load-out ticket photo (optional)' : (l.progress === 'picked' ? 'POD photo (optional)' : 'Empty-in ticket photo (optional)') %></label>
          <input type="file" name="evidence" accept="image/*"></div>
          <button type="submit" style="margin-top:6px">Next step: <%= l.progress === 'scheduled' ? 'Picked up' : (l.progress === 'picked' ? 'Delivered' : 'Returned') %></button>
        </form>
        <% } else { %>
        <div class="lc-meta" style="margin-top:8px">✅ Done</div>
        <% } %>
      </div>
      <% }) %>
    <% } %>

    <p class="notice">Fuel today: <%= todayFuel.gallons %> gal · <%= money(todayFuel.cost) %></p>
  </div>

  <div class="card">
    <h2>Menu</h2>
    <div class="menu-grid">
      <a class="menu-tile wide" href="/loads">
        <span class="mt-icon">📦</span>
        <span><span class="mt-title">Loads</span><br><span class="mt-sub">Enter a load from a dispatch or ticket photo, and view my loads</span></span>
        <% if (pendingCount > 0) { %><span class="mt-badge badge warn"><%= pendingCount %> pending</span><% } %>
      </a>
      <a class="menu-tile" href="/fuel">
        <span class="mt-icon">⛽</span>
        <span class="mt-title">Fuel</span>
        <span class="mt-sub">Enter fuel &amp; see my gallons</span>
      </a>
      <a class="menu-tile" href="/settlement">
        <span class="mt-icon">💵</span>
        <span class="mt-title">Settlement</span>
        <span class="mt-sub">My pay statements</span>
      </a>
      <a class="menu-tile" href="/documents">
        <span class="mt-icon">📁</span>
        <span class="mt-title">Documents</span>
        <span class="mt-sub">My documents<% if (expiringCount > 0) { %> · <%= expiringCount %> expiring soon<% } %></span>
      </a>
      <a class="menu-tile" href="/safety">
        <span class="mt-icon">🛡️</span>
        <span class="mt-title">Safety</span>
        <span class="mt-sub">Training · <%= safetyDone %> of <%= safetyTotal %> done</span>
      </a>
      <a class="menu-tile" href="/dvir">
        <span class="mt-icon">🔧</span>
        <span class="mt-title">Maintenance</span>
        <span class="mt-sub">Repairs &amp; inspections</span>
      </a>
      <a class="menu-tile" href="/more">
        <span class="mt-icon">⋯</span>
        <span class="mt-title">More</span>
        <span class="mt-sub">Rates · Benefits · Rules</span>
      </a>
    </div>
  </div>

  <div class="card">
    <h2>My evidence</h2>
    <% if (typeof evidenceMissing === 'undefined' || !evidenceMissing.length) { %>
      <p>✅ All recent evidence is in — nothing missing.</p>
    <% } else { %>
      <p class="notice">The loads below are missing evidence. Upload the tickets so settlement and billing are not held up.</p>
      <ul class="check-list">
        <% evidenceMissing.forEach(function(x){ %>
        <li><%= fmtDate(x.load.load_date) %> · <%= x.load.delivery || '' %> (<%= x.load.container_no || 'no container #' %>) —
          Missing: <b><%= x.missing.map(function(s){ return stageLabels[s]; }).join(', ') %></b>
          <a class="btn small" href="/loads">Upload</a></li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <div class="grid">
    <div class="stat"><div class="label">This week's pay (<%= weekStartISO %> ~ <%= weekEndISO %>)</div>
      <div class="value"><%= thisWeek ? money(thisWeek.driver_pay) : 'Not settled yet' %></div>
      <div class="notice"><%= thisWeek ? (thisWeek.status === 'closed' ? 'Closed' : 'Open') : 'Not settled yet.' %></div></div>
    <div class="stat"><div class="label">Last week's pay (<%= lastWeekStartISO %> ~ <%= lastWeekEndISO %>)</div>
      <div class="value"><%= lastWeek ? money(lastWeek.driver_pay) : '—' %></div>
      <div class="notice"><%= lastWeek ? (lastWeek.status === 'closed' ? 'Closed' : 'Open') : 'No record' %></div></div>
  </div>
<% } %>

<%- include('partials/footer') %>
