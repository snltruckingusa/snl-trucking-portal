<%- include('partials/header', { title: 'Maintenance' }) %>
<h1>Maintenance &amp; Inspections</h1>

<div class="card">
  <h2>Vehicle inspections (DVIR)</h2>
  <p class="notice">Inspections are done in the ZigZag ELD app before driving. The table below keeps the portal inspection records from before the switch.</p>

  <div class="table-wrap" style="margin-top:12px"><table>
    <tr><th>Date</th><th>Driver</th><th>Truck</th><th>Defects</th><th>Safe to operate</th><th></th></tr>
    <% dvir.forEach(function(v){ %>
    <tr>
      <td><%= fmtDate(v.inspection_date) %></td>
      <td><%= v.driver_name %></td>
      <td>#<%= v.truck_number || '' %></td>
      <td><%= v.defects || '—' %></td>
      <td><%= v.safe_to_operate ? 'Yes' : 'No' %></td>
      <td>
        <form class="inline" method="POST" action="/dvir/dvir/<%= v.id %>/delete" onsubmit="return confirm('Delete this record?')"><button class="btn small danger" type="submit">Delete</button></form>
      </td>
    </tr>
    <% }) %>
  </table></div>
  <% if (!dvir.length) { %><p class="notice">No DVIR records.</p><% } %>
</div>

<% if (isAdmin && typeof pendingLogs !== 'undefined' && pendingLogs.length) { %>
<div class="card">
  <h2>Repairs waiting for your review</h2>
  <p class="notice">Entered by drivers or shops. Reviewing records the entry into the truck's history — it confirms the record, not the repair.</p>
  <% pendingLogs.forEach(function(l){ %>
  <div style="border-top:1px solid #eee;padding:10px 0">
    <b>#<%= l.truck_number %></b> · <%= fmtDate(l.log_date) %> · <%= l.shop || l.mechanic || '' %> — <%= l.description %> · <b><%= money(l.cost) %></b><% if (l.entered_by) { %> · entered by <%= l.entered_by %><% } %><% if (l.photo_data) { %> · <a href="/mytruck/repairs/<%= l.id %>/photo">Invoice photo</a><% } %>
    <div style="margin-top:6px">
      <form class="inline" method="POST" action="/dvir/mechanic/<%= l.id %>/review"><button class="btn small" type="submit">Reviewed &amp; Recorded</button></form>
      <form class="inline" method="POST" action="/dvir/mechanic/<%= l.id %>/delete" onsubmit="return confirm('Delete this record?')"><button class="btn small danger" type="submit">Delete</button></form>
    </div>
  </div>
  <% }) %>
</div>
<% } %>

<div class="card">
  <h2>Mechanic Logs</h2>
  <form method="POST" action="/dvir/mechanic">
    <div class="form-row">
      <div><label>Truck #</label><input name="truck_number" required placeholder="100"></div>
      <div><label>Date</label><input type="date" name="log_date" required value="<%= fmtDate(new Date()) %>"></div>
      <div><label>Mechanic</label><input name="mechanic" placeholder="Dave"></div>
      <div><label>Cost ($)</label><input name="cost" type="number" step="0.01" value="0"></div>
    </div>
    <label>Work done</label>
    <textarea name="description" rows="2" required></textarea>
    <div style="margin-top:12px"><button type="submit">Save log</button></div>
  </form>

  <div class="table-wrap" style="margin-top:12px"><table>
    <tr><th>Date</th><th>Truck</th><th>Work done</th><th>Mechanic</th><th class="num">Cost</th><th></th></tr>
    <% logs.forEach(function(l){ %>
    <tr>
      <td><%= fmtDate(l.log_date) %></td>
      <td>#<%= l.truck_number %></td>
      <td><%= l.description %><% if (l.status === 'pending') { %> <span class="badge warn">Pending</span><% } %></td>
      <td><%= l.mechanic || '' %></td>
      <td class="num"><%= money(l.cost) %></td>
      <td>
        <form class="inline" method="POST" action="/dvir/mechanic/<%= l.id %>/delete" onsubmit="return confirm('Delete this record?')"><button class="btn small danger" type="submit">Delete</button></form>
      </td>
    </tr>
    <% }) %>
  </table></div>
  <% if (!logs.length) { %><p class="notice">No mechanic logs.</p><% } %>
</div>
<%- include('partials/footer') %>
