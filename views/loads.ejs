<%- include('partials/header', { title: 'Loads' }) %>
<h1>Loads</h1>
<% if (typeof notice !== 'undefined' && notice) { %><div class="alert"><%= notice %></div><% } %>

<div class="card">
  <h2>Add from dispatch capture or ticket photo (OCR)</h2>
  <p class="notice">Upload the dispatcher's order capture — the empty container and PIN, load container, PIN and BOL, delivery city, and appointment are read automatically to fill in the form below. A gate ticket or POD photo works too. <b>Read values are suggestions only — always check and fix them before saving.</b></p>
  <form method="POST" action="/loads/ocr" enctype="multipart/form-data">
    <label>Ticket photo</label>
    <input type="file" name="ticket" accept="image/*" required>
    <div style="margin-top:12px"><button type="submit">Read photo</button></div>
  </form>
  <% if (ocrNotice) { %><div class="alert" style="margin-top:12px"><%= ocrNotice %></div><% } %>
</div>

<div class="card">
  <h2>Add load</h2>
  <form method="POST" action="/loads">
    <% if (ocr && ocr.ticket_photo) { %><input type="hidden" name="ticket_photo" value="<%= ocr.ticket_photo %>"><% } %>
    <div class="form-row">
      <% if (isAdmin) { %>
      <div><label>Driver</label><select name="driver_id" required>
        <% drivers.forEach(function(d){ %><option value="<%= d.id %>" <%= ocr && scopedDriverId === d.id ? 'selected' : '' %>><%= d.name %> (#<%= d.truck_number || '' %>)</option><% }) %>
      </select></div>
      <% } else { %>
      <input type="hidden" name="driver_id" value="<%= scopedDriverId %>">
      <% } %>
      <div><label>Date</label><input type="date" name="load_date" required value="<%= fmtDate(new Date()) %>"></div>
    </div>
    <p class="notice" style="margin:10px 0 4px"><b>1 — Empty return</b> · which container goes into the terminal first</p>
    <div class="form-row">
      <div><label>Empty container #</label><input name="empty_container" value="<%= ocr ? (ocr.empty_container || '') : '' %>" placeholder="The empty you return today"></div>
      <div><label>Empty PIN</label><input name="empty_pin" value="<%= ocr ? (ocr.empty_pin || '') : '' %>"></div>
    </div>
    <p class="notice" style="margin:10px 0 4px"><b>2 — Load out &amp; delivery</b></p>
    <div class="form-row">
      <div><label>Container #</label><input name="container_no" value="<%= ocr ? ocr.container_no : '' %>" placeholder="MSKU3613700"></div>
      <div><label>Load PIN</label><input name="load_pin" value="<%= ocr ? (ocr.load_pin || '') : '' %>"></div>
      <div><label>BOL / Reference</label><input name="bol_ref" value="<%= ocr ? ocr.bol_ref : '' %>"></div>
      <div><label>Pickup</label><input name="pickup" value="<%= ocr ? ocr.pickup : '' %>"></div>
      <div><label>Delivery (city)</label><input name="delivery" value="<%= ocr ? ocr.delivery : '' %>"></div>
    </div>
    <div class="form-row">
      <div><label>Notes (address as dispatched)</label><input name="notes" value="<%= ocr ? (ocr.notes || '') : '' %>"></div>
      <div><label>Appointment</label><input type="datetime-local" name="appointment" value="<%= ocr && ocr.appointment ? ocr.appointment : '' %>"></div>
    </div>
    <div class="form-row">
      <div><label>Rate ($)</label><input name="rate" type="number" step="0.01" value="0"></div>
      <div><label>Prepull ($)</label><input name="prepull" type="number" step="0.01" value="0"></div>
      <div><label>Reefer ($)</label><input name="reefer" type="number" step="0.01" value="0"></div>
      <div><label>Detention ($)</label><input name="detention" type="number" step="0.01" value="0"></div>
      <div><label>Overweight ($)</label><input name="overweight" type="number" step="0.01" value="0"></div>
      <div><label>FSC ($)</label><input name="fsc" type="number" step="0.01" value="0"></div>
      <div><label>Miles</label><input name="miles" type="number" step="0.1" value="0"></div>
      <% if (isAdmin) { %><div><label>Status</label><select name="status"><option value="pending">Pending</option><option value="confirmed">Confirmed</option></select></div><% } %>
    </div>
    <div style="margin-top:12px"><button type="submit">Save load</button></div>
  </form>
  <p class="notice">Leave rate/FSC/miles blank to prefill the lane-chart defaults (suggestions only — the per-load actual amount set by the dispatcher always governs). Driver-entered detention stays pending until the owner approves it.</p>
</div>

<div class="card">
  <h2>Load list</h2>
  <% if (!isAdmin) { %>
  <form method="GET" action="/loads">
    <div class="form-row" style="align-items:end">
      <div><label>Day</label><input type="date" name="day" value="<%= day || '' %>"></div>
      <div><button type="submit">Go</button>
        <% if (prevDay) { %><a class="btn secondary" href="/loads?day=<%= prevDay %>">← Prev day</a><% } %>
        <% if (nextDay) { %><a class="btn secondary" href="/loads?day=<%= nextDay %>">Next day →</a><% } %></div>
    </div>
  </form>
  <% } else { %>
  <form method="GET" action="/loads">
    <div class="form-row">
      <div><label>From</label><input type="date" name="from" value="<%= filters.from %>"></div>
      <div><label>To</label><input type="date" name="to" value="<%= filters.to %>"></div>
      <div><label>Driver</label><select name="driver_id"><option value="">All</option>
        <% drivers.forEach(function(d){ %><option value="<%= d.id %>" <%= String(filters.driver_id) === String(d.id) ? 'selected' : '' %>><%= d.name %></option><% }) %>
      </select></div>
      <div><label>Status</label><select name="status"><option value="">All</option>
        <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
        <option value="confirmed" <%= filters.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option></select></div>
    </div>
    <div style="margin-top:12px"><button type="submit">Filter</button></div>
  </form>
  <% } %>

  <% if (!isAdmin) { %>
  <style>
    .step-card { border:1px solid #ddd; border-radius:12px; padding:12px 14px; margin-top:12px; background:#fff; }
    .sc-head { margin-bottom:6px; }
    .step { border-top:1px solid #eee; padding:9px 2px; }
    .step summary { cursor:pointer; }
    .step .step-ic { display:inline-block; min-width:24px; font-weight:700; }
    .step.done .step-ic { color:#1a7f37; }
    .step.current { background:#f2f6ff; border:1px solid #b9d2ff; border-radius:10px; padding:10px; margin-top:8px; }
    .step.future { opacity:.72; }
    .step-body { margin-top:8px; }
  </style>
  <% loads.forEach(function(l){ var ev = (typeof evidence !== 'undefined' && evidence) ? evidence[l.id] : null;
     var em = (typeof emptyMatch !== 'undefined' && emptyMatch) ? emptyMatch[l.id] : null;
     var emEv = em ? ((typeof evidence !== 'undefined' && evidence) ? evidence[em.id] : null) : null;
     var stages = [
       { key:'empty_return', n:2, title:'Empty return ticket', hint:'One photo of the empty-in ticket for the empty you brought into the terminal first.' },
       { key:'load_out', n:3, title:'Load-out ticket', hint:'One photo of the load-out (gate out) ticket. The container number and weights are read from it automatically.' },
       { key:'pod', n:4, title:'POD — delivery complete', hint:'One photo of the signed delivery order (POD).' },
       { key:'empty_in', n:5, title:'Empty-in ticket — this load', hint:'One photo of the empty-return ticket for THIS load\u2019s container, when you bring it back. This closes the job.' }
     ];
     var currentSet = false; %>
  <div class="step-card">
    <div class="sc-head"><b><%= fmtDate(l.load_date) %></b> · <%= l.container_no || '—' %> · <%= l.pickup || '?' %> → <%= l.delivery || '?' %>
      <span class="badge <%= l.status %>"><%= l.status === 'confirmed' ? 'Confirmed' : 'Pending' %></span>
      <b class="num"><%= money(loadTotal(l)) %></b>
      <% if (ev && ev.ow) { %><span class="badge flag">Ticket O/W over limit</span><% } %>
      <% var loIt = ev ? (ev.items.filter(function(it){ return it.stage === 'load_out'; }).slice(-1)[0] || null) : null;
         var mm = [];
         if (loIt && loIt.extracted) {
           if (loIt.extracted.container_no && l.container_no && String(loIt.extracted.container_no).toUpperCase() !== String(l.container_no).toUpperCase()) mm.push('container number');
           if (loIt.extracted.overweight && Number(l.overweight) === 0) mm.push('overweight');
           if (loIt.extracted.is_reefer && Number(l.reefer) === 0) mm.push('reefer');
         } %>
      <% if (mm.length) { %><span class="badge flag">⚠ Ticket mismatch: <%= mm.join(', ') %> — re-upload the ticket or fix the entry</span><% } %>
      <% if (l.status === 'pending') { %><a class="btn small danger" href="/loads/<%= l.id %>/delete-form">Delete</a><% } %>
    </div>
    <div class="step done"><span class="step-ic">✓</span> <b>Step 1 — Dispatch</b> <% if (l.dispatch_ok) { %><span class="notice"><b>Dispatch approved ✓</b></span><% } else { %><span class="notice"><b>Waiting for owner approval</b></span><% } %>
      <div class="step-body">
        <div><b>Empty return</b></div>
        <div class="notice">Container #: <b><%= l.empty_container || '—' %></b><% if (l.empty_pin) { %> · PIN #: <%= l.empty_pin %><% } %><% if (em) { %> <span>(from your <%= fmtDate(em.load_date) %> <%= em.delivery || '' %> load — its ticket is Step 2 below)</span><% } %></div>
        <div style="margin-top:6px"><b>Load out</b></div>
        <div class="notice">Container #: <b><%= l.container_no || '—' %></b><% if (l.load_pin) { %> · PIN #: <%= l.load_pin %><% } %><% if (l.bol_ref) { %> · BOL #: <%= l.bol_ref %><% } %></div>
        <div style="margin-top:6px"><b>Delivery</b></div>
        <div class="notice"><% if (l.d_company) { %>Company name: <%= l.d_company %><br><% } %><% if (l.d_address) { %>Address: <%= l.d_address %><br><% } %><% if (!l.d_company && !l.d_address && l.notes) { %><%= l.notes %><br><% } %>City: <%= l.delivery || '?' %><% if (l.appointment) { %><br>Appointment: <%= new Date(l.appointment).toLocaleString() %><% } %></div>
      </div>
    </div>
    <% stages.forEach(function(s){
       var done, item, refCont;
       if (s.key === 'empty_return') {
         refCont = l.empty_container;
         if (em) { done = !!(emEv && emEv.empty_in > 0); item = emEv ? (emEv.items.filter(function(it){ return it.stage === 'empty_in'; }).slice(-1)[0] || null) : null; }
         else { done = !!(ev && ev.other > 0); item = ev ? (ev.items.filter(function(it){ return it.stage === 'other'; }).slice(-1)[0] || null) : null; }
       } else {
         refCont = l.container_no;
         done = !!(ev && ev[s.key] > 0);
         item = ev ? (ev.items.filter(function(it){ return it.stage === s.key; }).slice(-1)[0] || null) : null;
       }
       var isCurrent = !done && !currentSet; if (isCurrent) currentSet = true; %>
    <details class="step <%= done ? 'done' : (isCurrent ? 'current' : 'future') %>" <%= isCurrent ? 'open' : '' %>>
      <summary><span class="step-ic"><%= done ? '✓' : s.n %></span> <b>Step <%= s.n %> — <%= s.title %></b>
        <% if (done && item) { %> <span class="notice"><%= new Date(item.created_at).toLocaleString() %><% if (item.extracted && item.extracted.cargo_wt) { %> · CARGO <%= Math.round(item.extracted.cargo_wt).toLocaleString() %> lb<% if (item.extracted.ow_limit) { %> / limit <%= item.extracted.ow_limit.toLocaleString() %> lb<% } %><% if (item.extracted.overweight) { %> · <b>O/W over</b><% } %><% } %><% if (item.extracted && item.extracted.container_no && refCont && String(item.extracted.container_no).toUpperCase() !== String(refCont).toUpperCase()) { %> · <b>⚠ Ticket container <%= item.extracted.container_no %> ≠ load <%= refCont %></b><% } %></span> <a href="/loads/evidence/<%= item.id %>/photo" target="_blank">View photo</a><% } %>
        <% if (!done && !isCurrent) { %> <span class="notice">Comes after the step above — open this only if you need to upload early.</span><% } %>
      </summary>
      <div class="step-body">
        <% if (done) { %><p class="notice">Photo on file. Upload again only to add another photo for this step.</p><% } else { %><p class="notice"><%= s.hint %></p><% } %>
        <form method="POST" action="/loads/<%= l.id %>/evidence" enctype="multipart/form-data">
          <input type="hidden" name="stage" value="<%= s.key %>">
          <div><label>Photo</label><input type="file" name="photo" accept="image/*" required></div>
          <div style="margin-top:6px"><button class="btn small" type="submit">Upload</button></div>
        </form>
      </div>
    </details>
    <% }) %>
    <% if (ev && ev.load_out > 0 && ev.pod > 0 && ev.empty_in > 0) { %><div class="step done"><span class="step-ic">✅</span> <b>Job complete</b></div><% } %>
    <div class="step"><span class="step-ic">$</span> <b>Settlement amount — <%= money(loadTotal(l)) %></b> <span class="notice">From the tickets. The owner approves and confirms at the end.</span>
      <div class="step-body"><span class="notice">Rate <%= money(l.rate) %> · Prepull <%= money(l.prepull) %> · Reefer <%= money(l.reefer) %> · Detention <%= money(l.detention) %><% if (l.detention_status === 'pending') { %> (pending)<% } %> · Overweight <%= money(l.overweight) %> · FSC <%= money(l.fsc) %></span></div>
    </div>
    <details class="step extra">
      <summary><span class="step-ic">+</span> <b>Detention claim</b> <span class="notice">Only with the dispatcher's confirmation message</span></summary>
      <div class="step-body">
        <% if (l.detention_status === 'pending') { %><p><span class="badge warn">Detention pending review <%= money(l.detention) %></span></p><% } %>
        <form method="POST" action="/loads/<%= l.id %>/detention" enctype="multipart/form-data">
          <div><label>Detention claim ($)</label><input name="amount" type="number" step="0.01" min="0" placeholder="50"></div>
          <div><label>Evidence photo (dispatcher message)</label><input type="file" name="photo" accept="image/*"></div>
          <div style="margin-top:6px"><button class="btn small secondary" type="submit">Claim detention</button></div>
        </form>
      </div>
    </details>
  </div>
  <% }) %>
  <% } else { %>
  <div class="table-wrap" style="margin-top:12px"><table>
    <tr><th>Date</th><th>Driver</th><th>Container / BOL</th><th>Pickup → Delivery</th><th class="num">Amount</th><th class="num">Miles</th><th>Status</th><th>Progress</th><th></th></tr>
    <% loads.forEach(function(l){ %>
    <tr>
      <td><%= fmtDate(l.load_date) %></td>
      <td><%= l.driver_name %> (#<%= l.truck_number || '' %>)</td>
      <td><%= l.container_no || '' %><br><span class="notice"><%= l.bol_ref || '' %></span>
        <% if (l.ticket_photo) { %><br><a href="<%= l.ticket_photo %>" target="_blank">Photo</a><% } %>
        <% var ev = (typeof evidence !== 'undefined' && evidence) ? evidence[l.id] : null; %>
        <% if (ev) { %><br><span class="notice">Evidence: Load out <%= ev.load_out ? '✓' : '—' %> · POD <%= ev.pod ? '✓' : '—' %> · Empty in <%= ev.empty_in ? '✓' : '—' %></span>
        <% if (ev.ow) { %><br><span class="badge flag">Ticket O/W over limit</span><% } %>
        <% var loIt2 = ev.items.filter(function(it){ return it.stage === 'load_out'; }).slice(-1)[0] || null;
           var mm2 = [];
           if (loIt2 && loIt2.extracted) {
             if (loIt2.extracted.container_no && l.container_no && String(loIt2.extracted.container_no).toUpperCase() !== String(l.container_no).toUpperCase()) mm2.push('container number');
             if (loIt2.extracted.overweight && Number(l.overweight) === 0) mm2.push('overweight');
             if (loIt2.extracted.is_reefer && Number(l.reefer) === 0) mm2.push('reefer');
           } %>
        <% if (mm2.length) { %><br><span class="badge flag">⚠ Ticket mismatch: <%= mm2.join(', ') %> — re-upload the ticket or fix the entry</span><% } %><% } %>
        <% if (l.detention_status === 'pending') { %><br><span class="badge warn">Detention pending review <%= money(l.detention) %></span><% } %>
      </td>
      <td><%= l.pickup || '' %> → <%= l.delivery || '' %><% if (l.notes) { %><br><span class="notice"><%= l.notes %></span><% } %></td>
      <td class="num"><%= money(loadTotal(l)) %></td>
      <td class="num"><%= l.miles %><% var lane = laneFor(l.delivery); if (lane && lane.gallons) { %><br><span class="notice">Std <%= lane.gallons %> gal</span><% } %></td>
      <td><span class="badge <%= l.status %>"><%= l.status === 'confirmed' ? 'Confirmed' : 'Pending' %></span><% if (l.status === 'pending') { %><br><span class="notice">Dispatch <%= l.dispatch_ok ? '✓' : '—' %> · Tickets <%= l.tickets_ok ? '✓' : '—' %></span><% } %></td>
      <td>
        <span class="badge progress"><%= PROGRESS_LABELS[l.progress] || l.progress %></span>
        <% if (l.progress !== 'returned' && (isAdmin || scopedDriverId === l.driver_id)) { %>
        <form class="inline" method="POST" action="/loads/<%= l.id %>/progress"><button class="btn small secondary" type="submit">Next step</button></form>
        <% } %>
      </td>
      <td>
        <% if (isAdmin && l.status === 'pending' && !l.dispatch_ok) { %>
        <form class="inline" method="POST" action="/loads/<%= l.id %>/approve-dispatch"><button class="btn small" type="submit">Approve dispatch</button></form>
        <% } %>
        <% if (isAdmin && l.status === 'pending' && l.dispatch_ok && !l.tickets_ok) { %>
        <form class="inline" method="POST" action="/loads/<%= l.id %>/approve-tickets"><button class="btn small secondary" type="submit">Approve tickets</button></form>
        <% } %>
        <% if (isAdmin && l.status === 'pending') { %>
        <form class="inline" method="POST" action="/loads/<%= l.id %>/confirm"><button class="btn small" type="submit">Confirm</button></form>
        <% } %>
        <% if (isAdmin || l.status === 'pending') { %><a class="btn small danger" href="/loads/<%= l.id %>/delete-form">Delete</a><% } %>
        <% if (isAdmin) { %>
        <details style="margin-top:6px">
          <summary class="btn small secondary">Edit</summary>
          <form method="POST" action="/loads/<%= l.id %>/edit" style="min-width:280px;margin-top:8px;text-align:left">
            <div><label>Date</label><input type="date" name="load_date" required value="<%= fmtDate(l.load_date) %>"></div>
            <div><label>Container #</label><input name="container_no" value="<%= l.container_no || '' %>"></div>
            <div><label>Load PIN</label><input name="load_pin" value="<%= l.load_pin || '' %>"></div>
            <div><label>Empty container #</label><input name="empty_container" value="<%= l.empty_container || '' %>"></div>
            <div><label>Empty PIN</label><input name="empty_pin" value="<%= l.empty_pin || '' %>"></div>
            <div><label>BOL / Reference</label><input name="bol_ref" value="<%= l.bol_ref || '' %>"></div>
            <div><label>Pickup</label><input name="pickup" value="<%= l.pickup || '' %>"></div>
            <div><label>Delivery</label><input name="delivery" value="<%= l.delivery || '' %>"></div>
            <div><label>Appointment</label><input type="datetime-local" name="appointment" value="<%= l.appointment ? fmtDateTimeLocal(l.appointment) : '' %>"></div>
            <div><label>Rate ($)</label><input name="rate" type="number" step="0.01" value="<%= l.rate %>"></div>
            <div><label>Prepull ($)</label><input name="prepull" type="number" step="0.01" value="<%= l.prepull %>"></div>
            <div><label>Reefer ($)</label><input name="reefer" type="number" step="0.01" value="<%= l.reefer %>"></div>
            <div><label>Detention ($)</label><input name="detention" type="number" step="0.01" value="<%= l.detention %>"></div>
            <div><label>Overweight ($)</label><input name="overweight" type="number" step="0.01" value="<%= l.overweight %>"></div>
            <div><label>FSC ($)</label><input name="fsc" type="number" step="0.01" value="<%= l.fsc %>"></div>
            <div><label>Miles</label><input name="miles" type="number" step="0.1" value="<%= l.miles %>"></div>
            <div><label>Notes</label><input name="notes" value="<%= l.notes || '' %>"></div>
            <div><label>Status</label><select name="status">
              <option value="pending" <%= l.status === 'pending' ? 'selected' : '' %>>Pending</option>
              <option value="confirmed" <%= l.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
            </select></div>
            <div style="margin-top:8px"><button class="btn small" type="submit">Save</button></div>
          </form>
        </details>
        <% } %>
        <details style="margin-top:6px">
          <summary class="btn small secondary">Evidence</summary>
          <div style="min-width:280px;margin-top:8px;text-align:left">
            <% if (ev && ev.items.length) { %>
            <ul class="check-list">
              <% ev.items.forEach(function(it){ %>
              <li><a href="/loads/evidence/<%= it.id %>/photo" target="_blank"><%= it.stage === 'load_out' ? 'Load-out ticket' : it.stage === 'pod' ? 'POD' : it.stage === 'empty_in' ? 'Empty-in ticket' : it.stage === 'detention' ? 'Detention evidence' : 'Other' %></a>
                <span class="notice"><%= new Date(it.created_at).toLocaleString() %></span>
                <% if (it.extracted && it.extracted.cargo_wt) { %><br><span class="notice">CARGO <%= Math.round(it.extracted.cargo_wt).toLocaleString() %> lb<% if (it.extracted.ow_limit) { %> / limit <%= it.extracted.ow_limit.toLocaleString() %> lb<% } %><% if (it.extracted.overweight) { %> · <b>O/W over</b><% } %></span><% } %>
              </li>
              <% }) %>
            </ul>
            <% } else { %><p class="notice">No evidence yet.</p><% } %>
            <form method="POST" action="/loads/<%= l.id %>/evidence" enctype="multipart/form-data" style="margin-top:8px">
              <div><label>Type</label><select name="stage">
                <option value="load_out">Load out EIR</option>
                <option value="pod">POD</option>
                <option value="empty_in">Empty in EIR</option>
                <option value="other">Other</option>
              </select></div>
              <div><label>Photo</label><input type="file" name="photo" accept="image/*" required></div>
              <div style="margin-top:6px"><button class="btn small" type="submit">Upload</button></div>
            </form>
            <form method="POST" action="/loads/<%= l.id %>/detention" enctype="multipart/form-data" style="margin-top:10px">
              <div><label>Detention claim ($) — based on the dispatcher's confirmation message</label>
              <input name="amount" type="number" step="0.01" min="0" placeholder="50"></div>
              <div><label>Evidence photo (dispatcher message)</label><input type="file" name="photo" accept="image/*"></div>
              <div style="margin-top:6px"><button class="btn small secondary" type="submit">Claim detention</button></div>
            </form>
            <% if (isAdmin && l.detention_status === 'pending') { %>
            <div style="margin-top:8px">
              <form class="inline" method="POST" action="/loads/<%= l.id %>/detention-approve"><button class="btn small" type="submit">Approve detention</button></form>
              <form class="inline" method="POST" action="/loads/<%= l.id %>/detention-reject"><button class="btn small danger" type="submit">Reject</button></form>
            </div>
            <% } %>
          </div>
        </details>
      </td>
    </tr>
    <% }) %>
  </table></div>
  <% } %>
  <% if (!loads.length) { %><p class="notice">No loads found.</p><% } %>
  <p class="notice">Only <b>confirmed</b> loads count in settlement.</p>
</div>
<%- include('partials/footer') %>
