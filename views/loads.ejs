<%- include('partials/header', { title: 'Loads' }) %>
<h1>Loads</h1>

<div class="card">
  <h2>Add from ticket photo (OCR)</h2>
  <p class="notice">Upload a POD / gate ticket photo and the container number, BOL, return location, pickup/delivery, and appointment time are read automatically to fill in the form below. <b>Read values are suggestions only. Always check and fix them before saving.</b><br>
  Upload a POD / gate ticket photo and the form below is prefilled. Values are suggestions only — review before saving.</p>
  <form method="POST" action="/loads/ocr" enctype="multipart/form-data">
    <label>Ticket photo</label>
    <input type="file" name="ticket" accept="image/*" required>
    <div style="margin-top:12px"><button type="submit">Read photo</button></div>
  </form>
  <% if (ocrNotice) { %><div class="alert" style="margin-top:12px"><%= ocrNotice %></div><% } %>
</div>

<div class="card">
  <h2>Add load</h2>
  <form method="POST" action="/loads">
    <% if (ocr && ocr.ticket_photo) { %><input type="hidden" name="ticket_photo" value="<%= ocr.ticket_photo %>"><% } %>
    <div class="form-row">
      <% if (isAdmin) { %>
      <div><label>Driver</label><select name="driver_id" required>
        <% drivers.forEach(function(d){ %><option value="<%= d.id %>" <%= ocr && scopedDriverId === d.id ? 'selected' : '' %>><%= d.name %> (#<%= d.truck_number || '' %>)</option><% }) %>
      </select></div>
      <% } else { %>
      <input type="hidden" name="driver_id" value="<%= scopedDriverId %>">
      <% } %>
      <div><label>Date</label><input type="date" name="load_date" required value="<%= new Date().toISOString().slice(0,10) %>"></div>
      <div><label>Container #</label><input name="container_no" value="<%= ocr ? ocr.container_no : '' %>" placeholder="MSKU3613700"></div>
      <div><label>BOL / Reference</label><input name="bol_ref" value="<%= ocr ? ocr.bol_ref : '' %>"></div>
    </div>
    <div class="form-row">
      <div><label>Pickup</label><input name="pickup" value="<%= ocr ? ocr.pickup : '' %>"></div>
      <div><label>Delivery</label><input name="delivery" value="<%= ocr ? ocr.delivery : '' %>"></div>
      <div><label>Empty return</label><input name="notes" value="<%= ocr ? ocr.return_location : '' %>" placeholder="ITS Conglobal etc."></div>
      <div><label>Appointment</label><input type="datetime-local" name="appointment" value="<%= ocr && ocr.appointment ? ocr.appointment : '' %>"></div>
    </div>
    <div class="form-row">
      <div><label>Rate ($)</label><input name="rate" type="number" step="0.01" value="0"></div>
      <div><label>Prepull ($)</label><input name="prepull" type="number" step="0.01" value="0"></div>
      <div><label>Reefer ($)</label><input name="reefer" type="number" step="0.01" value="0"></div>
      <div><label>Detention ($)</label><input name="detention" type="number" step="0.01" value="0"></div>
      <div><label>Overweight ($)</label><input name="overweight" type="number" step="0.01" value="0"></div>
      <div><label>FSC ($)</label><input name="fsc" type="number" step="0.01" value="0"></div>
      <div><label>Miles</label><input name="miles" type="number" step="0.1" value="0"></div>
      <div><label>Status</label><select name="status"><option value="pending">Pending</option><option value="confirmed">Confirmed</option></select></div>
    </div>
    <div style="margin-top:12px"><button type="submit">Save load</button></div>
  </form>
  <p class="notice">If you leave rate/FSC/miles blank, the rate-chart defaults for the delivery city are filled in automatically (suggested values — the actual per-load amount set by the dispatcher always comes first). Detention entered by a driver stays pending for review and is added to settlement after the admin approves it.<br>
  Leave rate/FSC/miles blank to prefill the lane chart defaults (suggestions only — the per-load actual always governs). Driver-entered detention stays pending until the owner approves it.</p>
</div>

<div class="card">
  <h2>Load list</h2>
  <form method="GET" action="/loads">
    <div class="form-row">
      <div><label>From</label><input type="date" name="from" value="<%= filters.from %>"></div>
      <div><label>To</label><input type="date" name="to" value="<%= filters.to %>"></div>
      <% if (isAdmin) { %>
      <div><label>Driver</label><select name="driver_id"><option value="">All</option>
        <% drivers.forEach(function(d){ %><option value="<%= d.id %>" <%= String(filters.driver_id) === String(d.id) ? 'selected' : '' %>><%= d.name %></option><% }) %>
      </select></div>
      <% } %>
      <div><label>Status</label><select name="status"><option value="">All</option>
        <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
        <option value="confirmed" <%= filters.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option></select></div>
    </div>
    <div style="margin-top:12px"><button type="submit">Filter</button></div>
  </form>

  <div class="table-wrap" style="margin-top:12px"><table>
    <tr><th>Date</th><th>Driver</th><th>Container / BOL</th><th>Pickup → Delivery</th><th class="num">Amount</th><th class="num">Miles</th><th>Status</th><th>Progress</th><th></th></tr>
    <% loads.forEach(function(l){ %>
    <tr>
      <td><%= fmtDate(l.load_date) %></td>
      <td><%= l.driver_name %> (#<%= l.truck_number || '' %>)</td>
      <td><%= l.container_no || '' %><br><span class="notice"><%= l.bol_ref || '' %></span>
        <% if (l.ticket_photo) { %><br><a href="<%= l.ticket_photo %>" target="_blank">Photo</a><% } %>
        <% var ev = (typeof evidence !== 'undefined' && evidence) ? evidence[l.id] : null; %>
        <% if (ev) { %><br><span class="notice">Evidence: Load out <%= ev.load_out ? '✓' : '—' %> · POD <%= ev.pod ? '✓' : '—' %> · Empty in <%= ev.empty_in ? '✓' : '—' %></span>
        <% if (ev.ow) { %><br><span class="badge flag">Ticket O/W over limit</span><% } %><% } %>
        <% if (l.detention_status === 'pending') { %><br><span class="badge warn">Detention pending review <%= money(l.detention) %></span><% } %>
      </td>
      <td><%= l.pickup || '' %> → <%= l.delivery || '' %><% if (l.notes) { %><br><span class="notice"><%= l.notes %></span><% } %></td>
      <td class="num"><%= money(loadTotal(l)) %></td>
      <td class="num"><%= l.miles %><% var lane = laneFor(l.delivery); if (lane && lane.gallons) { %><br><span class="notice">Std <%= lane.gallons %> gal</span><% } %></td>
      <td><span class="badge <%= l.status %>"><%= l.status === 'confirmed' ? 'Confirmed' : 'Pending' %></span></td>
      <td>
        <span class="badge progress"><%= PROGRESS_LABELS[l.progress] || l.progress %></span>
        <% if (l.progress !== 'returned' && (isAdmin || scopedDriverId === l.driver_id)) { %>
        <form class="inline" method="POST" action="/loads/<%= l.id %>/progress"><button class="btn small secondary" type="submit">Next step</button></form>
        <% } %>
      </td>
      <td>
        <% if (l.status === 'pending') { %>
        <form class="inline" method="POST" action="/loads/<%= l.id %>/confirm"><button class="btn small" type="submit">Confirm</button></form>
        <% } %>
        <a class="btn small danger" href="/loads/<%= l.id %>/delete-form">Delete</a>
        <% if (isAdmin) { %>
        <details style="margin-top:6px">
          <summary class="btn small secondary">Edit</summary>
          <form method="POST" action="/loads/<%= l.id %>/edit" style="min-width:280px;margin-top:8px;text-align:left">
            <div><label>Date</label><input type="date" name="load_date" required value="<%= fmtDate(l.load_date) %>"></div>
            <div><label>Container #</label><input name="container_no" value="<%= l.container_no || '' %>"></div>
            <div><label>BOL / Reference</label><input name="bol_ref" value="<%= l.bol_ref || '' %>"></div>
            <div><label>Pickup</label><input name="pickup" value="<%= l.pickup || '' %>"></div>
            <div><label>Delivery</label><input name="delivery" value="<%= l.delivery || '' %>"></div>
            <div><label>Appointment</label><input type="datetime-local" name="appointment" value="<%= l.appointment ? new Date(l.appointment).toISOString().slice(0,16) : '' %>"></div>
            <div><label>Rate ($)</label><input name="rate" type="number" step="0.01" value="<%= l.rate %>"></div>
            <div><label>Prepull ($)</label><input name="prepull" type="number" step="0.01" value="<%= l.prepull %>"></div>
            <div><label>Reefer ($)</label><input name="reefer" type="number" step="0.01" value="<%= l.reefer %>"></div>
            <div><label>Detention ($)</label><input name="detention" type="number" step="0.01" value="<%= l.detention %>"></div>
            <div><label>Overweight ($)</label><input name="overweight" type="number" step="0.01" value="<%= l.overweight %>"></div>
            <div><label>FSC ($)</label><input name="fsc" type="number" step="0.01" value="<%= l.fsc %>"></div>
            <div><label>Miles</label><input name="miles" type="number" step="0.1" value="<%= l.miles %>"></div>
            <div><label>Notes</label><input name="notes" value="<%= l.notes || '' %>"></div>
            <div><label>Status</label><select name="status">
              <option value="pending" <%= l.status === 'pending' ? 'selected' : '' %>>Pending</option>
              <option value="confirmed" <%= l.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
            </select></div>
            <div style="margin-top:8px"><button class="btn small" type="submit">Save</button></div>
          </form>
        </details>
        <% } %>
        <details style="margin-top:6px">
          <summary class="btn small secondary">Evidence</summary>
          <div style="min-width:280px;margin-top:8px;text-align:left">
            <% if (ev && ev.items.length) { %>
            <ul class="check-list">
              <% ev.items.forEach(function(it){ %>
              <li><a href="/loads/evidence/<%= it.id %>/photo" target="_blank"><%= it.stage === 'load_out' ? 'Load-out ticket' : it.stage === 'pod' ? 'POD' : it.stage === 'empty_in' ? 'Empty-in ticket' : it.stage === 'detention' ? 'Detention evidence' : 'Other' %></a>
                <span class="notice"><%= new Date(it.created_at).toLocaleString() %></span>
                <% if (it.extracted && it.extracted.cargo_wt) { %><br><span class="notice">CARGO <%= Math.round(it.extracted.cargo_wt).toLocaleString() %> lb<% if (it.extracted.ow_limit) { %> / limit <%= it.extracted.ow_limit.toLocaleString() %> lb<% } %><% if (it.extracted.overweight) { %> · <b>O/W over</b><% } %></span><% } %>
              </li>
              <% }) %>
            </ul>
            <% } else { %><p class="notice">No evidence yet.</p><% } %>
            <form method="POST" action="/loads/<%= l.id %>/evidence" enctype="multipart/form-data" style="margin-top:8px">
              <div><label>Type</label><select name="stage">
                <option value="load_out">Load out EIR</option>
                <option value="pod">POD</option>
                <option value="empty_in">Empty in EIR</option>
                <option value="other">Other</option>
              </select></div>
              <div><label>Photo</label><input type="file" name="photo" accept="image/*" required></div>
              <div style="margin-top:6px"><button class="btn small" type="submit">Upload</button></div>
            </form>
            <form method="POST" action="/loads/<%= l.id %>/detention" enctype="multipart/form-data" style="margin-top:10px">
              <div><label>Detention claim ($) — based on the dispatcher's confirmation message</label>
              <input name="amount" type="number" step="0.01" min="0" placeholder="50"></div>
              <div><label>Evidence photo (dispatcher message)</label><input type="file" name="photo" accept="image/*"></div>
              <div style="margin-top:6px"><button class="btn small secondary" type="submit">Claim detention</button></div>
            </form>
            <% if (isAdmin && l.detention_status === 'pending') { %>
            <div style="margin-top:8px">
              <form class="inline" method="POST" action="/loads/<%= l.id %>/detention-approve"><button class="btn small" type="submit">Approve detention</button></form>
              <form class="inline" method="POST" action="/loads/<%= l.id %>/detention-reject"><button class="btn small danger" type="submit">Reject</button></form>
            </div>
            <% } %>
          </div>
        </details>
      </td>
    </tr>
    <% }) %>
  </table></div>
  <% if (!loads.length) { %><p class="notice">No loads found.</p><% } %>
  <p class="notice">Only <b>confirmed</b> loads count in settlement.</p>
</div>
<%- include('partials/footer') %>
