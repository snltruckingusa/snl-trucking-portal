<%- include('partials/header', { title: 'Loads' }) %>
<h1>운행 / Loads</h1>

<div class="card">
  <h2>티켓 사진으로 입력 / Add from ticket photo (OCR)</h2>
  <p class="notice">POD / 게이트 티켓 사진을 올리면 컨테이너 번호, BOL, 반납 장소, 픽업/배송, 약속 시간을 자동으로 읽어 아래 양식을 채웁니다. <b>읽힌 값은 제안일 뿐입니다. 저장하기 전에 꼭 확인하고 수정하세요.</b><br>
  Upload a POD / gate ticket photo and the form below is prefilled. Values are suggestions only — review before saving.</p>
  <form method="POST" action="/loads/ocr" enctype="multipart/form-data">
    <label>티켓 사진 / Ticket photo</label>
    <input type="file" name="ticket" accept="image/*" required>
    <div style="margin-top:12px"><button type="submit">사진 읽어오기 / Read photo</button></div>
  </form>
  <% if (ocrNotice) { %><div class="alert" style="margin-top:12px"><%= ocrNotice %></div><% } %>
</div>

<div class="card">
  <h2>운행 입력 / Add load</h2>
  <form method="POST" action="/loads">
    <% if (ocr && ocr.ticket_photo) { %><input type="hidden" name="ticket_photo" value="<%= ocr.ticket_photo %>"><% } %>
    <div class="form-row">
      <% if (isAdmin) { %>
      <div><label>기사 / Driver</label><select name="driver_id" required>
        <% drivers.forEach(function(d){ %><option value="<%= d.id %>" <%= ocr && scopedDriverId === d.id ? 'selected' : '' %>><%= d.name %> (#<%= d.truck_number || '' %>)</option><% }) %>
      </select></div>
      <% } else { %>
      <input type="hidden" name="driver_id" value="<%= scopedDriverId %>">
      <% } %>
      <div><label>날짜 / Date</label><input type="date" name="load_date" required value="<%= new Date().toISOString().slice(0,10) %>"></div>
      <div><label>컨테이너 번호 / Container #</label><input name="container_no" value="<%= ocr ? ocr.container_no : '' %>" placeholder="MSKU3613700"></div>
      <div><label>BOL / Reference</label><input name="bol_ref" value="<%= ocr ? ocr.bol_ref : '' %>"></div>
    </div>
    <div class="form-row">
      <div><label>픽업 / Pickup</label><input name="pickup" value="<%= ocr ? ocr.pickup : '' %>"></div>
      <div><label>배송 / Delivery</label><input name="delivery" value="<%= ocr ? ocr.delivery : '' %>"></div>
      <div><label>반납 장소 / Empty return</label><input name="notes" value="<%= ocr ? ocr.return_location : '' %>" placeholder="ITS Conglobal 등"></div>
      <div><label>약속 시간 / Appointment</label><input type="datetime-local" name="appointment" value="<%= ocr && ocr.appointment ? ocr.appointment : '' %>"></div>
    </div>
    <div class="form-row">
      <div><label>기본 요금 / Rate ($)</label><input name="rate" type="number" step="0.01" value="0"></div>
      <div><label>Prepull ($)</label><input name="prepull" type="number" step="0.01" value="0"></div>
      <div><label>Reefer ($)</label><input name="reefer" type="number" step="0.01" value="0"></div>
      <div><label>Detention ($)</label><input name="detention" type="number" step="0.01" value="0"></div>
      <div><label>Overweight ($)</label><input name="overweight" type="number" step="0.01" value="0"></div>
      <div><label>FSC ($)</label><input name="fsc" type="number" step="0.01" value="0"></div>
      <div><label>마일 / Miles</label><input name="miles" type="number" step="0.1" value="0"></div>
      <div><label>상태 / Status</label><select name="status"><option value="pending">대기 (Pending)</option><option value="confirmed">확정 (Confirmed)</option></select></div>
    </div>
    <div style="margin-top:12px"><button type="submit">저장 / Save load</button></div>
  </form>
</div>

<div class="card">
  <h2>운행 목록 / Load list</h2>
  <form method="GET" action="/loads">
    <div class="form-row">
      <div><label>부터 / From</label><input type="date" name="from" value="<%= filters.from %>"></div>
      <div><label>까지 / To</label><input type="date" name="to" value="<%= filters.to %>"></div>
      <% if (isAdmin) { %>
      <div><label>기사 / Driver</label><select name="driver_id"><option value="">전체 / All</option>
        <% drivers.forEach(function(d){ %><option value="<%= d.id %>" <%= String(filters.driver_id) === String(d.id) ? 'selected' : '' %>><%= d.name %></option><% }) %>
      </select></div>
      <% } %>
      <div><label>상태 / Status</label><select name="status"><option value="">전체 / All</option>
        <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>대기</option>
        <option value="confirmed" <%= filters.status === 'confirmed' ? 'selected' : '' %>>확정</option></select></div>
    </div>
    <div style="margin-top:12px"><button type="submit">조회 / Filter</button></div>
  </form>

  <div class="table-wrap" style="margin-top:12px"><table>
    <tr><th>날짜</th><th>기사</th><th>컨테이너 / BOL</th><th>픽업 → 배송</th><th class="num">금액</th><th class="num">마일</th><th>상태</th><th>진행</th><th></th></tr>
    <% loads.forEach(function(l){ %>
    <tr>
      <td><%= fmtDate(l.load_date) %></td>
      <td><%= l.driver_name %> (#<%= l.truck_number || '' %>)</td>
      <td><%= l.container_no || '' %><br><span class="notice"><%= l.bol_ref || '' %></span>
        <% if (l.ticket_photo) { %><br><a href="<%= l.ticket_photo %>" target="_blank">사진 / Photo</a><% } %></td>
      <td><%= l.pickup || '' %> → <%= l.delivery || '' %><% if (l.notes) { %><br><span class="notice"><%= l.notes %></span><% } %></td>
      <td class="num"><%= money(loadTotal(l)) %></td>
      <td class="num"><%= l.miles %></td>
      <td><span class="badge <%= l.status %>"><%= l.status === 'confirmed' ? '확정' : '대기' %></span></td>
      <td>
        <span class="badge progress"><%= PROGRESS_LABELS[l.progress] || l.progress %></span>
        <% if (l.progress !== 'returned' && (isAdmin || scopedDriverId === l.driver_id)) { %>
        <form class="inline" method="POST" action="/loads/<%= l.id %>/progress"><button class="btn small secondary" type="submit">다음 단계</button></form>
        <% } %>
      </td>
      <td>
        <% if (l.status === 'pending') { %>
        <form class="inline" method="POST" action="/loads/<%= l.id %>/confirm"><button class="btn small" type="submit">확정</button></form>
        <% } %>
        <form class="inline" method="POST" action="/loads/<%= l.id %>/delete" onsubmit="return confirm('삭제할까요?')"><button class="btn small danger" type="submit">삭제</button></form>
      </td>
    </tr>
    <% }) %>
  </table></div>
  <% if (!loads.length) { %><p class="notice">기록이 없습니다. No loads found.</p><% } %>
  <p class="notice">정산에는 <b>확정(Confirmed)</b>된 운행만 포함됩니다. Only confirmed loads count in settlement.</p>
</div>
<%- include('partials/footer') %>
