<%# Invoice: weekly briefing home (no driver selected), one driver's
    detail (?driver=<id>), or the full original page (?driver=all).
    The driver block and totals markup below are the original ones —
    only the home dashboard is new. %>
<%
  var dq = driverParam ? '&driver=' + encodeURIComponent(driverParam) : '';
  var vq = view === 'drivers' ? '&view=drivers' : '';
  var shownBlocks = view === 'all' ? blocks
    : (view === 'driver' && selectedBlock ? [selectedBlock] : []);
  // Server-rendered donut (inline SVG, pathLength=100 segments).
  // centerValue must be pre-formatted by the caller (e.g. money(x)).
  function donutHTML(donut, size, centerLabel, centerValue) {
    var sw = size > 120 ? 13 : 15;
    var h = '<svg width="' + size + '" height="' + size + '" viewBox="0 0 120 120" role="img">';
    h += '<circle cx="60" cy="60" r="50" fill="none" stroke="#e3e6ea" stroke-width="' + sw + '"/>';
    if (donut) {
      h += '<g transform="rotate(-90 60 60)" fill="none" stroke-width="' + sw + '">';
      donut.slices.forEach(function (s) {
        if (s.pct > 0) {
          h += '<circle cx="60" cy="60" r="50" pathLength="100" stroke="' + s.color
             + '" stroke-dasharray="' + s.pct + ' ' + (100 - s.pct)
             + '" stroke-dashoffset="' + s.offset + '"/>';
        }
      });
      h += '</g>';
    }
    if (centerLabel) {
      h += '<text x="60" y="54" text-anchor="middle" font-size="10" fill="#888">' + centerLabel + '</text>';
    }
    h += '<text x="60" y="' + (centerLabel ? 74 : 67) + '" text-anchor="middle" font-size="'
       + (size > 120 ? 17 : 14) + '" font-weight="700" fill="#333">' + centerValue + '</text>';
    h += '</svg>';
    return h;
  }
%>
<%- include('partials/header', { title: 'Invoice' }) %>
<h1>PierLink Invoice</h1>
<p class="notice">Week: Sunday ~ Saturday. Claims can be adjusted separately from driver settlement. Loads whose empty return is not confirmed are held and carried into the next invoice as "Previous unpaid." Recording a payment (Paid) reduces that line's balance.<br>
Claims are independent of driver settlement. Unpaid balances carry into the next invoice. Recording a payment reduces that line's balance.</p>

<div style="display:flex;gap:8px;margin:12px 0">
  <a class="btn<%= view === 'drivers' ? ' secondary' : '' %>" href="/invoice?week=<%= weekISO %>">PierLink Invoice — Weekly Claim</a>
  <a class="btn<%= view === 'drivers' ? '' : ' secondary' %>" href="/invoice?week=<%= weekISO %>&view=drivers">Driver Invoices — Statements</a>
</div>

<div class="card">
  <form method="GET" action="/invoice" class="form-row" style="align-items:end">
    <div><label>Week of (Sun)</label><input type="date" name="week" value="<%= weekISO %>"></div>
    <% if (driverParam) { %><input type="hidden" name="driver" value="<%= driverParam %>"><% } %>
    <% if (view === 'drivers') { %><input type="hidden" name="view" value="drivers"><% } %>
    <div><button type="submit">View</button>
      <a class="btn secondary" href="/invoice?week=<%= prevWeek %><%= dq %><%= vq %>">← Prev week</a>
      <a class="btn secondary" href="/invoice?week=<%= nextWeek %><%= dq %><%= vq %>">Next week →</a>
      <button class="btn secondary" type="button" onclick="window.print()">Print</button></div>
  </form>
  <p style="margin-top:10px"><b><%= weekISO %> ~ <%= weekEndISO %></b><% if (week.sent_at) { %> · <span class="badge good">Sent <%= new Date(week.sent_at).toLocaleDateString() %></span><% } %>
  <% if (view === 'drivers') { %> · <a href="/invoice?week=<%= weekISO %>">← PierLink invoice</a><% } else if (view === 'home') { %> · <a href="/invoice?week=<%= weekISO %>&driver=all">Full invoice view (all drivers)</a> · <a href="/invoice/claim-list?week=<%= weekISO %>">Claim list for PierLink (leg by leg)</a><% } else { %> · <a href="/invoice?week=<%= weekISO %>">← Weekly dashboard</a> · <a href="/invoice/claim-list?week=<%= weekISO %>">Claim list for PierLink (leg by leg)</a><% } %></p>
</div>

<% if (view === 'drivers') { %>
<div class="card">
  <h2>Driver invoices — <%= weekISO %> ~ <%= weekEndISO %></h2>
  <p class="notice">Each driver's weekly statement — the same document the driver checks and confirms in Settlement. Open a statement to print it or save it for the driver.</p>
  <div class="table-wrap"><table>
    <tr><th>Driver</th><th class="num">Revenue</th><th class="num">Fuel</th><th class="num">Insurance</th><th class="num">Driver pay</th><th>Driver confirm</th><th></th></tr>
    <% stmtRows.forEach(function (r) { var cf = confirms[r.driver.id]; %>
    <tr>
      <td><b><%= r.driver.name %></b> <span class="notice">(#<%= r.driver.truck_number || '' %>)</span></td>
      <td class="num"><%= money(r.revenue) %></td>
      <td class="num"><%= money(r.fuelCost) %></td>
      <td class="num"><%= money(r.insurance) %></td>
      <td class="num"><b><%= money(r.driverPay) %></b></td>
      <td><% if (cf && cf.note) { %><span class="badge warn">Question asked</span> <span class="notice"><%= cf.note %></span><% } else if (cf && cf.confirmed_at) { %><span class="badge good">Confirmed ✓</span> <span class="notice"><%= new Date(cf.confirmed_at).toLocaleString() %></span><% } else { %><span class="notice">Not confirmed</span><% } %></td>
      <td><a class="btn secondary" href="/settlement/statement?driver_id=<%= r.driver.id %>&week=<%= weekISO %>" target="_blank" rel="noopener">Statement</a></td>
    </tr>
    <% }) %>
    <% if (!stmtRows.length) { %><tr><td colspan="7" class="notice">No driver settlements for this week yet.</td></tr><% } %>
  </table></div>
</div>
<% } %>

<% if (view === 'home') { %>
<div class="card">
  <h2>Week at a glance</h2>
  <div style="display:flex;justify-content:space-around;align-items:flex-end;text-align:center;flex-wrap:wrap;gap:8px">
    <div>
      <%- donutHTML(donuts.prev, 92, '', donuts.prev ? money(donuts.prev.total) : '—') %>
      <div class="notice">Prev week</div>
    </div>
    <div>
      <%- donutHTML(donuts.cur, 158, 'Week total', donuts.cur ? money(donuts.cur.total) : '—') %>
      <div><b>This week</b></div>
    </div>
    <div>
      <%- donutHTML(donuts.next, 92, '', donuts.next ? money(donuts.next.total) : '—') %>
      <div class="notice">Next week</div>
    </div>
  </div>
  <% if (donuts.cur) { %>
  <p style="text-align:center;margin-top:10px">
    <% donuts.cur.slices.forEach(function (s) { %>
    <span style="margin:0 8px;white-space:nowrap"><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:<%= s.color %>"></span> <%= s.label %> <b><%= money(s.amount) %></b></span>
    <% }) %>
  </p>
  <p class="notice" style="text-align:center">Money flow from driver settlement for the same week (driver pay / fuel / insurance / company share).</p>
  <% } else { %>
  <p class="notice" style="text-align:center">No settlement money for this week yet.</p>
  <% } %>
</div>

<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px">
  <div class="card" style="flex:1;min-width:140px;text-align:center;margin:0">
    <div class="notice">Total claim (this week)</div>
    <div style="font-size:20px"><b><%= money(cards.totalClaim) %></b></div>
  </div>
  <div class="card" style="flex:1;min-width:140px;text-align:center;margin:0">
    <div class="notice">Driver pay</div>
    <div style="font-size:20px"><b><%= cards.driverPay === null ? '—' : money(cards.driverPay) %></b></div>
  </div>
  <div class="card" style="flex:1;min-width:140px;text-align:center;margin:0">
    <div class="notice">Company profit</div>
    <div style="font-size:20px"><b><%= cards.companyProfit === null ? '—' : money(cards.companyProfit) %></b></div>
  </div>
  <div class="card" style="flex:1;min-width:140px;text-align:center;margin:0<% if (cards.unpaidTotal > 0) { %>;border-color:#d9534f<% } %>">
    <div class="notice"<% if (cards.unpaidTotal > 0) { %> style="color:#d9534f"<% } %>>Unpaid (carried in)</div>
    <div style="font-size:20px;<% if (cards.unpaidTotal > 0) { %>color:#d9534f;<% } %>"><b><%= money(cards.unpaidTotal) %></b></div>
  </div>
</div>

<% if (unpaidWeeks) { %>
<div class="card">
  <h2>Unpaid by week — resolve one by one</h2>
  <div class="table-wrap"><table>
    <tr><th>Week</th><th class="num">Claimed</th><th class="num">Received</th><th class="num">Balance</th><th>Status</th></tr>
    <% unpaidWeeks.rows.forEach(function (r) { %>
    <tr<% if (r.resolved) { %> style="color:#888"<% } %>>
      <td><% if (r.weekISO) { %>Week ending Sat <%= r.weekEndISO %><% if (r.current) { %> <span class="badge">This week</span><% } %><% } else { %><%= r.label %><% } %></td>
      <td class="num"><%= money(r.claimed) %></td>
      <td class="num"><%= money(r.received) %></td>
      <td class="num"><b><%= money(r.balance) %></b></td>
      <td><% if (r.resolved) { %>✓ Resolved<% } else if (r.current) { %>Awaiting deposit<% } else { %>Open<% } %></td>
    </tr>
    <% }) %>
  </table></div>
  <p class="notice">One row per week, checked off as it resolves — the Unpaid card above is the sum of the open rows before this week. A live week's balance = expected deposit (claim + Help Ins − $500 deduct) − received − adjustments; sealed weeks use the submitted totals. Resolve a week in <a href="/ar">A/R</a> by recording the deposit or an adjustment with its reason.</p>
</div>
<% } %>

<div class="card">
  <h2>Weekly Claim — by driver</h2>
  <div class="table-wrap"><table>
    <tr><th>Driver</th><th class="num">Claim (this week)</th><th class="num">Paid (this week)</th><th class="num">Previous unpaid</th><th class="num">Balance</th><th></th></tr>
    <% driverList.forEach(function (d) { %>
    <tr>
      <td><a href="/invoice?week=<%= weekISO %>&driver=<%= d.driver.id %>"><b><%= d.driver.name %></b></a> <span class="notice">(#<%= d.driver.truck_number || '' %>)</span></td>
      <td class="num"><%= money(d.weekClaim) %></td>
      <td class="num"><%= money(d.paidWeek) %></td>
      <td class="num"><% if (d.prevUnpaid > 0) { %><b style="color:#d9534f"><%= money(d.prevUnpaid) %></b><% } else { %><%= money(d.prevUnpaid) %><% } %></td>
      <td class="num"><b><%= money(d.carryOut) %></b></td>
      <td class="num"><a href="/invoice?week=<%= weekISO %>&driver=<%= d.driver.id %>">View →</a></td>
    </tr>
    <% }) %>
    <% if (!driverList.length) { %><tr><td colspan="6" class="notice">No claims this week.</td></tr><% } %>
  </table></div>
  <p class="notice">Balance = still owed after this week's payments (previous unpaid + this week). Open a driver for the line-by-line claim, payments, and manual claims.</p>
</div>
<% } %>

<% if (view === 'driver') { %>
<p><a href="/invoice?week=<%= weekISO %>">← All drivers (weekly dashboard)</a></p>
<% } %>

<% shownBlocks.forEach(function(b){ %>
<div class="card">
  <h2><%= b.driver.name %> <span class="notice">(#<%= b.driver.truck_number || '' %>)</span></h2>
  <p><b>Previous unpaid amount (Mty Return): <%= money(b.prevUnpaid) %></b></p>
  <div class="table-wrap"><table>
    <tr><th>Date</th><th>Delivery / Return</th><th class="num">Rate</th><th class="num">Prepull</th><th class="num">Reefer</th><th class="num">Detent</th><th class="num">O/W</th><th class="num">FSC</th><th class="num">Claim</th><th class="num">Paid (this week)</th><th class="num">Balance</th><th class="no-print"></th></tr>
    <% b.prevLines.forEach(function(l){ %>
    <tr class="prev-line">
      <td><%= fmtDate(l.load_date || l.claim_week) %></td>
      <td><%= l.description || l.load_delivery || '' %><br><span class="notice">Carried over · <%= l.container_no || '' %> · <%= l.returned ? 'Empty returned' : 'Empty not returned' %></span></td>
      <td class="num"><%= money(l.rate) %></td><td class="num"><%= money(l.prepull) %></td><td class="num"><%= money(l.reefer) %></td><td class="num"><%= money(l.detention) %></td><td class="num"><%= money(l.overweight) %></td><td class="num"><%= money(l.fsc) %></td>
      <td class="num"><%= money(l.claim) %></td>
      <td class="num"><b><%= money(l.paidThis) %></b></td>
      <td class="num"><%= money(l.balanceNow) %></td>
      <td class="no-print"><%- include('partials/invoice-line-actions', { l: l, weekISO: weekISO }) %></td>
    </tr>
    <% }) %>
    <% b.weekLines.forEach(function(l){ %>
    <tr>
      <td><%= fmtDate(l.load_date || l.claim_week) %></td>
      <td><%= l.description || l.load_delivery || '' %><br><span class="notice"><%= l.container_no || '' %> · <%= l.returned ? 'Empty returned' : 'Empty not returned' %></span></td>
      <td class="num"><%= money(l.rate) %></td><td class="num"><%= money(l.prepull) %></td><td class="num"><%= money(l.reefer) %></td><td class="num"><%= money(l.detention) %></td><td class="num"><%= money(l.overweight) %></td><td class="num"><%= money(l.fsc) %></td>
      <td class="num"><%= money(l.claim) %></td>
      <td class="num"><b><%= money(l.paidThis) %></b></td>
      <td class="num"><%= money(l.balanceNow) %></td>
      <td class="no-print"><%- include('partials/invoice-line-actions', { l: l, weekISO: weekISO }) %></td>
    </tr>
    <% }) %>
    <% if (!b.prevLines.length && !b.weekLines.length) { %><tr><td colspan="12" class="notice">No claims.</td></tr><% } %>
  </table></div>
  <p style="margin-top:8px">Paid this week: <b><%= money(b.paidWeek) %></b> · <b>Payment for Next week (Mty Not Return): <%= money(b.carryOut) %></b></p>
  <details class="no-print">
    <summary class="btn small secondary">Add manual claim</summary>
    <form method="POST" action="/invoice/lines" style="margin-top:8px">
      <input type="hidden" name="week" value="<%= weekISO %>">
      <input type="hidden" name="driver_id" value="<%= b.driver.id %>">
      <div class="form-row">
        <div><label>Description</label><input name="description"></div>
        <div><label>Rate</label><input name="rate" type="number" step="0.01" value="0"></div>
        <div><label>Return</label><input name="return_fee" type="number" step="0.01" value="0"></div>
        <div><label>Prepull</label><input name="prepull" type="number" step="0.01" value="0"></div>
        <div><label>Reefer</label><input name="reefer" type="number" step="0.01" value="0"></div>
        <div><label>Detent</label><input name="detention" type="number" step="0.01" value="0"></div>
        <div><label>O/W</label><input name="overweight" type="number" step="0.01" value="0"></div>
        <div><label>FSC</label><input name="fsc" type="number" step="0.01" value="0"></div>
      </div>
      <div style="margin-top:8px"><button class="btn small" type="submit">Add</button></div>
    </form>
  </details>
</div>
<% }) %>

<% if (view === 'home' || view === 'all') { %>
<div class="card">
  <h2>Totals</h2>
  <div class="table-wrap"><table>
    <tr><td>Total (Paid on this invoice)</td><td class="num"><b><%= money(totalPaidWeek) %></b></td></tr>
    <tr><td>Help Ins (<%= deliveredCount %> deliveries × $15<% if (week.help_ins_override !== null && week.help_ins_override !== undefined) { %> · manual override<% } %>)</td><td class="num"><%= money(helpIns) %></td></tr>
    <tr><td>Deduct (advance repayment)</td><td class="num">− <%= money(deduct) %></td></tr>
    <tr><td>Expected</td><td class="num"><b><%= money(expected) %></b></td></tr>
    <tr><td>Receive (actual deposit)</td><td class="num"><%= money(received) %></td></tr>
    <tr><td><b>Balance (receivable)</b></td><td class="num"><b><%= money(balance) %></b></td></tr>
  </table></div>

  <form method="POST" action="/invoice/week" class="no-print" style="margin-top:12px">
    <input type="hidden" name="week" value="<%= weekISO %>">
    <div class="form-row">
      <div><label>Help Ins override (leave blank for auto $<%= helpInsAuto %>)</label><input name="help_ins_override" type="number" step="0.01" value="<%= week.help_ins_override !== null && week.help_ins_override !== undefined ? week.help_ins_override : '' %>"></div>
      <div><label>Advance balance (before this invoice)</label><input name="advance_before" type="number" step="0.01" value="<%= week.advance_before !== null && week.advance_before !== undefined ? week.advance_before : '' %>" placeholder="Not set"></div>
      <div><label>Deduct this week</label><input name="advance_deduct" type="number" step="0.01" value="<%= week.advance_deduct %>"></div>
      <div><label>Receive (actual deposit)</label><input name="received" type="number" step="0.01" value="<%= week.received %>"></div>
      <div><label style="display:inline"><input type="checkbox" name="mark_sent" <%= week.sent_at ? 'checked' : '' %>> Mark sent</label></div>
    </div>
    <div style="margin-top:8px"><button class="btn small" type="submit">Save</button></div>
  </form>
  <% if (week.advance_before !== null && week.advance_before !== undefined) { %>
  <p class="notice">Advance: balance before this invoice <%= money(week.advance_before) %> → <%= money(Math.max(0, Number(week.advance_before) - Number(week.advance_deduct))) %> left after the deduction.</p>
  <% } %>
</div>
<% } %>
<%- include('partials/footer') %>
