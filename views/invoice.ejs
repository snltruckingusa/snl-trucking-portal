<%- include('partials/header', { title: 'Invoice' }) %>
<h1>PierLink Invoice</h1>
<p class="notice">Week: Sunday ~ Saturday. Claims can be adjusted separately from driver settlement. Loads whose empty return is not confirmed are held and carried into the next invoice as "Previous unpaid." Recording a payment (Paid) reduces that line's balance.<br>
Claims are independent of driver settlement. Unpaid balances carry into the next invoice. Recording a payment reduces that line's balance.</p>

<div class="card">
  <form method="GET" action="/invoice" class="form-row" style="align-items:end">
    <div><label>Week of (Sun)</label><input type="date" name="week" value="<%= weekISO %>"></div>
    <div><button type="submit">View</button>
      <a class="btn secondary" href="/invoice?week=<%= prevWeek %>">← Prev week</a>
      <a class="btn secondary" href="/invoice?week=<%= nextWeek %>">Next week →</a>
      <button class="btn secondary" type="button" onclick="window.print()">Print</button></div>
  </form>
  <p style="margin-top:10px"><b><%= weekISO %> ~ <%= weekEndISO %></b><% if (week.sent_at) { %> · <span class="badge good">Sent <%= new Date(week.sent_at).toLocaleDateString() %></span><% } %></p>
</div>

<% blocks.forEach(function(b){ %>
<div class="card">
  <h2><%= b.driver.name %> <span class="notice">(#<%= b.driver.truck_number || '' %>)</span></h2>
  <p><b>Previous unpaid amount (Mty Return): <%= money(b.prevUnpaid) %></b></p>
  <div class="table-wrap"><table>
    <tr><th>Date</th><th>Delivery / Return</th><th class="num">Rate</th><th class="num">Prepull</th><th class="num">Reefer</th><th class="num">Detent</th><th class="num">O/W</th><th class="num">FSC</th><th class="num">Claim</th><th class="num">Paid (this week)</th><th class="num">Balance</th><th class="no-print"></th></tr>
    <% b.prevLines.forEach(function(l){ %>
    <tr class="prev-line">
      <td><%= fmtDate(l.load_date || l.claim_week) %></td>
      <td><%= l.description || l.load_delivery || '' %><br><span class="notice">Carried over · <%= l.container_no || '' %> · <%= l.returned ? 'Empty returned' : 'Empty not returned' %></span></td>
      <td class="num"><%= money(l.rate) %></td><td class="num"><%= money(l.prepull) %></td><td class="num"><%= money(l.reefer) %></td><td class="num"><%= money(l.detention) %></td><td class="num"><%= money(l.overweight) %></td><td class="num"><%= money(l.fsc) %></td>
      <td class="num"><%= money(l.claim) %></td>
      <td class="num"><b><%= money(l.paidThis) %></b></td>
      <td class="num"><%= money(l.balanceNow) %></td>
      <td class="no-print"><%- include('partials/invoice-line-actions', { l: l, weekISO: weekISO }) %></td>
    </tr>
    <% }) %>
    <% b.weekLines.forEach(function(l){ %>
    <tr>
      <td><%= fmtDate(l.load_date || l.claim_week) %></td>
      <td><%= l.description || l.load_delivery || '' %><br><span class="notice"><%= l.container_no || '' %> · <%= l.returned ? 'Empty returned' : 'Empty not returned' %></span></td>
      <td class="num"><%= money(l.rate) %></td><td class="num"><%= money(l.prepull) %></td><td class="num"><%= money(l.reefer) %></td><td class="num"><%= money(l.detention) %></td><td class="num"><%= money(l.overweight) %></td><td class="num"><%= money(l.fsc) %></td>
      <td class="num"><%= money(l.claim) %></td>
      <td class="num"><b><%= money(l.paidThis) %></b></td>
      <td class="num"><%= money(l.balanceNow) %></td>
      <td class="no-print"><%- include('partials/invoice-line-actions', { l: l, weekISO: weekISO }) %></td>
    </tr>
    <% }) %>
    <% if (!b.prevLines.length && !b.weekLines.length) { %><tr><td colspan="12" class="notice">No claims.</td></tr><% } %>
  </table></div>
  <p style="margin-top:8px">Paid this week: <b><%= money(b.paidWeek) %></b> · <b>Payment for Next week (Mty Not Return): <%= money(b.carryOut) %></b></p>
  <details class="no-print">
    <summary class="btn small secondary">Add manual claim</summary>
    <form method="POST" action="/invoice/lines" style="margin-top:8px">
      <input type="hidden" name="week" value="<%= weekISO %>">
      <input type="hidden" name="driver_id" value="<%= b.driver.id %>">
      <div class="form-row">
        <div><label>Description</label><input name="description"></div>
        <div><label>Rate</label><input name="rate" type="number" step="0.01" value="0"></div>
        <div><label>Prepull</label><input name="prepull" type="number" step="0.01" value="0"></div>
        <div><label>Reefer</label><input name="reefer" type="number" step="0.01" value="0"></div>
        <div><label>Detent</label><input name="detention" type="number" step="0.01" value="0"></div>
        <div><label>O/W</label><input name="overweight" type="number" step="0.01" value="0"></div>
        <div><label>FSC</label><input name="fsc" type="number" step="0.01" value="0"></div>
      </div>
      <div style="margin-top:8px"><button class="btn small" type="submit">Add</button></div>
    </form>
  </details>
</div>
<% }) %>

<div class="card">
  <h2>Totals</h2>
  <div class="table-wrap"><table>
    <tr><td>Total (Paid on this invoice)</td><td class="num"><b><%= money(totalPaidWeek) %></b></td></tr>
    <tr><td>Help Ins (<%= deliveredCount %> deliveries × $15<% if (week.help_ins_override !== null && week.help_ins_override !== undefined) { %> · manual override<% } %>)</td><td class="num"><%= money(helpIns) %></td></tr>
    <tr><td>Deduct (advance repayment)</td><td class="num">− <%= money(deduct) %></td></tr>
    <tr><td>Expected</td><td class="num"><b><%= money(expected) %></b></td></tr>
    <tr><td>Receive (actual deposit)</td><td class="num"><%= money(received) %></td></tr>
    <tr><td><b>Balance (receivable)</b></td><td class="num"><b><%= money(balance) %></b></td></tr>
  </table></div>

  <form method="POST" action="/invoice/week" class="no-print" style="margin-top:12px">
    <input type="hidden" name="week" value="<%= weekISO %>">
    <div class="form-row">
      <div><label>Help Ins override (leave blank for auto $<%= helpInsAuto %>)</label><input name="help_ins_override" type="number" step="0.01" value="<%= week.help_ins_override !== null && week.help_ins_override !== undefined ? week.help_ins_override : '' %>"></div>
      <div><label>Advance balance (before this invoice)</label><input name="advance_before" type="number" step="0.01" value="<%= week.advance_before !== null && week.advance_before !== undefined ? week.advance_before : '' %>" placeholder="Not set"></div>
      <div><label>Deduct this week</label><input name="advance_deduct" type="number" step="0.01" value="<%= week.advance_deduct %>"></div>
      <div><label>Receive (actual deposit)</label><input name="received" type="number" step="0.01" value="<%= week.received %>"></div>
      <div><label style="display:inline"><input type="checkbox" name="mark_sent" <%= week.sent_at ? 'checked' : '' %>> Mark sent</label></div>
    </div>
    <div style="margin-top:8px"><button class="btn small" type="submit">Save</button></div>
  </form>
  <% if (week.advance_before !== null && week.advance_before !== undefined) { %>
  <p class="notice">Advance: balance before this invoice <%= money(week.advance_before) %> → <%= money(Math.max(0, Number(week.advance_before) - Number(week.advance_deduct))) %> left after the deduction.</p>
  <% } %>
</div>
<%- include('partials/footer') %>
