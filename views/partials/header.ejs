<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>S&L Trucking Portal</title>
<link rel="stylesheet" href="/style.css">
</head>
<body class="<%= user && user.role !== 'admin' ? 'has-tabbar' : '' %>">
<header class="topbar">
  <div class="brand">S&amp;L Trucking <span class="sub">snltruckingusa.com</span></div>
  <% if (user) { %>
  <div class="who">
    <%= user.username %>
    <% if (user.role === 'admin') { %>(Admin)<% } else if (user.role === 'mechanic') { %>(Mechanic)<% } else { %>(<%= user.driver_name || 'Driver' %><% if (user.truck_number) { %> #<%= user.truck_number %><% } %>)<% } %>
    · <a class="who-link" href="/change-password">Password</a>
    · <a class="who-link" href="/logout">Logout</a>
  </div>
  <% if (user.role === 'admin') { %>
  <nav class="nav">
    <a href="/">Dashboard</a>
    <a href="/loads">Loads</a>
    <a href="/fuel">Fuel</a>
    <a href="/settlement">Settlement</a>
    <a href="/invoice">Invoice</a>
    <a href="/documents">My File</a>
    <a href="/drivers">Drivers</a>
    <a href="/receipts">Receipts</a>
    <a href="/users">Users</a>
  </nav>
  <nav class="nav nav-secondary">
    <span class="nav-group-label">More:</span>
    <a href="/safety">Safety</a>
    <a href="/instructions">Rules</a>
    <a href="/rates">Rates</a>
    <a href="/benefits">Benefits</a>
    <a href="/settlement/mpg">MPG</a>
    <a href="/dvir">Maintenance</a>
    <a href="/mytruck">My Truck</a>
  </nav>
  <% } else if (user.role === 'mechanic') { %>
  <nav class="nav">
    <a href="/mechanic">Repair Entry</a>
  </nav>
  <% } else { %>
  <nav class="tabbar">
    <a href="/">Home</a>
    <a href="/loads">Loads</a>
    <a href="/settlement">Pay</a>
    <a href="/documents">My File</a>
    <a href="/more">More</a>
  </nav>
  <% } %>
  <% } %>
</header>
<main class="container">
