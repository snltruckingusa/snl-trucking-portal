<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>S&L Trucking Portal</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="topbar">
  <div class="brand">S&amp;L Trucking <span class="sub">snltruckingusa.com</span></div>
  <% if (user) { %>
  <nav class="nav">
    <a href="/">대시보드 / Dashboard</a>
    <a href="/loads">운행 / Loads</a>
    <a href="/fuel">연료 / Fuel</a>
    <a href="/settlement">정산 / Settlement</a>
    <a href="/settlement/mpg">연비 / MPG</a>
    <a href="/documents">서류 / Documents</a>
    <a href="/dvir">점검 / DVIR</a>
    <a href="/safety">안전교육 / Safety</a>
    <a href="/instructions">규정 / Rules</a>
    <a href="/benefits">복리후생 / Benefits</a>
    <% if (user.role === 'admin') { %>
      <a href="/drivers">기사 / Drivers</a>
      <a href="/receipts">입금 / Receipts</a>
      <a href="/users">계정 / Users</a>
    <% } %>
    <a href="/change-password">비밀번호 / Password</a>
    <a href="/logout">로그아웃 / Logout</a>
  </nav>
  <div class="who">
    <%= user.username %>
    <% if (user.role === 'admin') { %>(관리자 / Admin)<% } else { %>(<%= user.driver_name || 'Driver' %><% if (user.truck_number) { %> #<%= user.truck_number %><% } %>)<% } %>
  </div>
  <% } %>
</header>
<main class="container">
