<details>
  <summary class="btn small secondary">Actions</summary>
  <div style="min-width:260px;text-align:left;margin-top:6px">
    <form method="POST" action="/invoice/lines/<%= l.id %>/pay">
      <input type="hidden" name="week" value="<%= weekISO %>">
      <label>Record paid ($) — leave blank for the full balance</label>
      <input name="amount" type="number" step="0.01" placeholder="<%= l.balanceNow %>">
      <button class="btn small" type="submit" style="margin-top:4px">Record paid</button>
    </form>
    <% if (l.paidThis > 0) { %>
    <form method="POST" action="/invoice/lines/<%= l.id %>/unpay" style="margin-top:6px">
      <input type="hidden" name="week" value="<%= weekISO %>">
      <button class="btn small secondary" type="submit">Undo last payment</button>
    </form>
    <% } %>
    <form method="POST" action="/invoice/lines/<%= l.id %>/edit" style="margin-top:8px">
      <input type="hidden" name="week" value="<%= weekISO %>">
      <div><label>Description</label><input name="description" value="<%= l.description || '' %>"></div>
      <div><label>Rate</label><input name="rate" type="number" step="0.01" value="<%= l.rate %>"></div>
      <div><label>Prepull</label><input name="prepull" type="number" step="0.01" value="<%= l.prepull %>"></div>
      <div><label>Reefer</label><input name="reefer" type="number" step="0.01" value="<%= l.reefer %>"></div>
      <div><label>Detent</label><input name="detention" type="number" step="0.01" value="<%= l.detention %>"></div>
      <div><label>O/W</label><input name="overweight" type="number" step="0.01" value="<%= l.overweight %>"></div>
      <div><label>FSC</label><input name="fsc" type="number" step="0.01" value="<%= l.fsc %>"></div>
      <button class="btn small" type="submit" style="margin-top:4px">Save claim</button>
    </form>
    <form method="POST" action="/invoice/lines/<%= l.id %>/delete" style="margin-top:6px" onsubmit="return confirm('Delete this claim line? (Cannot delete if it has payment records)')">
      <input type="hidden" name="week" value="<%= weekISO %>">
      <button class="btn small danger" type="submit">Delete line</button>
    </form>
  </div>
</details>
