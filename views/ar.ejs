<%# A/R: briefing home (view='home') or one customer's week-by-week
    remittance matching (view='customer'). Claims are read from the
    invoice system for the invoice-linked customer and from manual
    claim weeks for everyone else; Listed / Received are A/R's own
    records (ar_entries). %>
<%
  function donutHTML(donut, size, centerLabel, centerValue) {
    var sw = size > 120 ? 13 : 15;
    var h = '<svg width="' + size + '" height="' + size + '" viewBox="0 0 120 120" role="img">';
    h += '<circle cx="60" cy="60" r="50" fill="none" stroke="#e3e6ea" stroke-width="' + sw + '"/>';
    if (donut) {
      h += '<g transform="rotate(-90 60 60)" fill="none" stroke-width="' + sw + '">';
      donut.slices.forEach(function (s) {
        if (s.pct > 0) {
          h += '<circle cx="60" cy="60" r="50" pathLength="100" stroke="' + s.color
             + '" stroke-dasharray="' + s.pct + ' ' + (100 - s.pct)
             + '" stroke-dashoffset="' + s.offset + '"/>';
        }
      });
      h += '</g>';
    }
    if (centerLabel) {
      h += '<text x="60" y="54" text-anchor="middle" font-size="10" fill="#888">' + centerLabel + '</text>';
    }
    h += '<text x="60" y="' + (centerLabel ? 74 : 67) + '" text-anchor="middle" font-size="'
       + (size > 120 ? 17 : 14) + '" font-weight="700" fill="#333">' + centerValue + '</text>';
    h += '</svg>';
    return h;
  }
  function statusBadge(st) {
    if (st.key === 'closed') return '<span class="badge good">' + st.label + '</span>';
    if (st.key === 'explained') return '<span class="badge progress">' + st.label + '</span>';
    if (st.key === 'open') return '<span class="badge open">' + st.label + '</span>';
    if (st.key === 'partial') return '<span class="badge warn">' + st.label + '</span>';
    return '<span class="badge flag">' + st.label + '</span>';
  }
  function kindLabel(k) {
    if (k === 'listed') return 'Listed';
    if (k === 'adjustment') return 'Adjustment (reason)';
    return 'Received';
  }
%>
<%- include('partials/header', { title: 'A/R' }) %>

<% if (view === 'home') { %>
<h1>A/R — Accounts Receivable</h1>
<p class="notice">Money in, per customer. Every claim week moves through three stages: <b>Claimed</b> (what we say the week is worth) → <b>Listed</b> (what the customer announced on their weekly deposit list) → <b>Received</b> (the deposit actually landed). A week whose claimed ≠ received stays open below with its difference — claimed = received + still owed, to the cent.</p>

<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px">
  <div class="card" style="flex:1;min-width:150px;text-align:center;margin:0">
    <div class="notice">Total receivable</div>
    <div style="font-size:22px"><b><%= money(cards.receivable) %></b></div>
  </div>
  <div class="card" style="flex:1;min-width:140px;text-align:center;margin:0">
    <div class="notice">Total claimed</div>
    <div style="font-size:20px"><b><%= money(cards.claimed) %></b></div>
  </div>
  <div class="card" style="flex:1;min-width:140px;text-align:center;margin:0">
    <div class="notice">Total received</div>
    <div style="font-size:20px"><b><%= money(cards.received) %></b></div>
  </div>
  <div class="card" style="flex:1;min-width:140px;text-align:center;margin:0<% if (cards.openWeeks > 0) { %>;border-color:#d9534f<% } %>">
    <div class="notice"<% if (cards.openWeeks > 0) { %> style="color:#d9534f"<% } %>>Open weeks</div>
    <div style="font-size:20px;<% if (cards.openWeeks > 0) { %>color:#d9534f;<% } %>"><b><%= cards.openWeeks %></b></div>
  </div>
</div>

<div class="card">
  <h2>By customer</h2>
  <% if (donut) { %>
  <div style="text-align:center">
    <%- donutHTML(donut, 150, 'Receivable', money(donut.total)) %>
    <p style="margin-top:6px">
      <% donut.slices.forEach(function (s) { %>
      <span style="margin:0 8px;white-space:nowrap"><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:<%= s.color %>"></span> <%= s.label %> <b><%= money(s.amount) %></b></span>
      <% }) %>
    </p>
  </div>
  <% } %>
  <div class="table-wrap"><table>
    <tr><th>Customer</th><th class="num">Claimed</th><th class="num">Listed</th><th class="num">Received</th><th class="num">Balance</th><th class="num">Open weeks</th><th></th></tr>
    <% custRows.forEach(function (r) { %>
    <tr>
      <td><a href="/ar/customer/<%= r.customer.id %>"><b><%= r.customer.name %></b></a><% if (r.customer.invoice_linked) { %> <span class="notice">(claims from Invoice)</span><% } %></td>
      <td class="num"><%= money(r.totals.claimed) %></td>
      <td class="num"><%= money(r.totals.listed) %></td>
      <td class="num"><%= money(r.totals.received) %></td>
      <td class="num"><b><% if (r.totals.balance > 0) { %><span style="color:#d9534f"><%= money(r.totals.balance) %></span><% } else { %><%= money(r.totals.balance) %><% } %></b></td>
      <td class="num"><%= r.totals.openWeeks %></td>
      <td class="num"><a href="/ar/customer/<%= r.customer.id %>">View →</a></td>
    </tr>
    <% }) %>
    <% if (!custRows.length) { %><tr><td colspan="7" class="notice">No customers yet.</td></tr><% } %>
  </table></div>
</div>

<div class="card">
  <h2>Open differences (newest first)</h2>
  <div class="table-wrap"><table>
    <tr><th>Customer</th><th>Week ending (Sat)</th><th class="num">Claimed</th><th class="num">Received</th><th class="num">Difference</th><th>Status</th><th class="num">Open for</th></tr>
    <% openDiffs.forEach(function (w) { %>
    <tr>
      <td><a href="/ar/customer/<%= w.customer.id %>"><%= w.customer.name %></a></td>
      <td><%= w.weekLabel %></td>
      <td class="num"><%= money(w.claimed) %></td>
      <td class="num"><%= money(w.received) %></td>
      <td class="num"><b style="color:#d9534f"><%= money(w.status.diff) %></b></td>
      <td><%- statusBadge(w.status) %></td>
      <td class="num"><%= w.ageWeeks %> wk</td>
    </tr>
    <% }) %>
    <% if (!openDiffs.length) { %><tr><td colspan="7" class="notice">Nothing open — every claimed week is received in full.</td></tr><% } %>
  </table></div>
  <% if (openDiffCount > openDiffs.length) { %><p class="notice">Showing the newest <%= openDiffs.length %> of <%= openDiffCount %> open weeks — open a customer for its full list.</p><% } %>
</div>

<div class="card">
  <h2>Recent receipts</h2>
  <div class="table-wrap"><table>
    <tr><th>Date</th><th>Customer</th><th>For week ending (Sat)</th><th class="num">Amount</th><th>Method</th><th>Note</th></tr>
    <% receipts.forEach(function (r) { %>
    <tr>
      <td><%= r.entry_date %></td>
      <td><%= r.customer_name %></td>
      <td><%= r.weekLabel %></td>
      <td class="num"><%= money(r.amount) %></td>
      <td><%= r.method || '' %></td>
      <td><%= r.note || '' %></td>
    </tr>
    <% }) %>
    <% if (!receipts.length) { %><tr><td colspan="6" class="notice">No deposits recorded yet.</td></tr><% } %>
  </table></div>
</div>

<% if (canWrite) { %>
<div class="card">
  <h2>Add a customer</h2>
  <form method="POST" action="/ar/customers" class="form-row" style="flex-wrap:wrap;gap:10px;align-items:end">
    <div><label>Customer name</label><input type="text" name="name" required></div>
    <div><label>Note</label><input type="text" name="note"></div>
    <div><button type="submit">Add customer</button></div>
  </form>
  <p class="notice">A new customer tracks manual claim weeks. Only PierLink is linked to the Invoice page — its claims are read from there automatically.</p>
</div>
<% } %>

<% } else { %>
<%# ---------------- Customer drill-down ---------------- %>
<p><a href="/ar">← All customers</a></p>
<h1><%= customer.name %> <% if (customer.invoice_linked) { %><span class="badge progress">Claims from Invoice</span><% } else { %><span class="badge open">Manual claims</span><% } %></h1>
<% if (customer.invoice_linked) { %><p class="no-print"><a href="/invoice/claim-list?week=<%= claimListWeek %>">Weekly claim list for PierLink (leg by leg) →</a> <span class="notice">— the Saturday send sheet these claimed totals come from</span></p><% } %>

<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px">
  <div class="card" style="flex:1;min-width:130px;text-align:center;margin:0"><div class="notice">Claimed</div><div style="font-size:19px"><b><%= money(customer.totals.claimed) %></b></div></div>
  <div class="card" style="flex:1;min-width:130px;text-align:center;margin:0"><div class="notice">Listed</div><div style="font-size:19px"><b><%= money(customer.totals.listed) %></b></div></div>
  <div class="card" style="flex:1;min-width:130px;text-align:center;margin:0"><div class="notice">Received</div><div style="font-size:19px"><b><%= money(customer.totals.received) %></b></div></div>
  <div class="card" style="flex:1;min-width:130px;text-align:center;margin:0"><div class="notice">Balance still owed</div><div style="font-size:19px"><b><%= money(customer.totals.balance) %></b></div></div>
</div>

<div class="card">
  <h2>Weeks</h2>
  <div class="table-wrap"><table>
    <tr><th>Week ending (Sat)</th><th class="num">Claimed</th><th class="num">Listed</th><th class="num">Received</th><th class="num">Difference</th><th>Status</th><% if (customer.invoice_linked) { %><th class="num">Invoice-page payments*</th><% } %></tr>
    <% weeks.forEach(function (w) { %>
    <tr>
      <td><b><%= w.weekLabel %></b></td>
      <td class="num"><%= money(w.claimed) %></td>
      <td class="num"><%= money(w.listed) %></td>
      <td class="num"><%= money(w.received) %><% if (w.receivedDates && w.receivedDates.length) { %><br><span class="notice">received <%= w.receivedDates.join(', ') %></span><% } %></td>
      <td class="num"><% if (w.status.key !== 'closed') { %><b style="color:#d9534f"><%= money(w.status.diff) %></b><% } else { %><%= money(w.status.diff) %><% } %><% if (w.status.diff !== 0 && w.explainedItems && w.explainedItems.length) { %><br><span class="notice"><% w.explainedItems.forEach(function (i) { %>· <%= i.label %>: <%= money(i.amount) %><br><% }) %>· Unexplained: <b><%= money(w.unexplained) %></b></span><% } %></td>
      <td><%- statusBadge(w.status) %></td>
      <% if (customer.invoice_linked) { %><td class="num"><%= money(w.invoicePaid) %></td><% } %>
    </tr>
    <% }) %>
    <% if (!weeks.length) { %><tr><td colspan="<%= customer.invoice_linked ? 7 : 6 %>" class="notice">No claim weeks yet.</td></tr><% } %>
  </table></div>
  <% if (customer.invoice_linked) { %><p class="notice">* Read-only reference: payments recorded per claim line on the Invoice page, grouped by the lines' claim week. A/R's own Received column above is what closes a week here.</p><% } %>
</div>

<% if (canWrite) { %>
<div class="card">
  <h2>Record a list announcement / deposit</h2>
  <form method="POST" action="/ar/entries" class="form-row" style="flex-wrap:wrap;gap:10px;align-items:end">
    <input type="hidden" name="customer_id" value="<%= customer.id %>">
    <div><label>For week ending (Sat)</label><input type="date" name="week_of" required value="<%= todayISO %>" data-week-sat="entryWeekSat"><div id="entryWeekSat" class="notice"></div></div>
    <div><label>Kind</label>
      <select name="kind"><% entryKinds.forEach(function (k) { %><option value="<%= k %>"><%= k === 'listed' ? 'Listed (announced)' : (k === 'adjustment' ? 'Adjustment (difference reason)' : 'Received (deposit landed)') %></option><% }) %></select></div>
    <div><label>Amount $</label><input type="number" name="amount" step="0.01" required></div>
    <div><label>Date</label><input type="date" name="entry_date" value="<%= todayISO %>"></div>
    <div><label>Method</label>
      <select name="method"><option value="">—</option><% entryMethods.forEach(function (m) { %><option value="<%= m %>"><%= m %></option><% }) %></select></div>
    <div><label>Note</label><input type="text" name="note"></div>
    <div><button type="submit">Record</button></div>
  </form>
  <p class="notice">Pick any day of the week — it is filed under the week ending that Saturday (weeks run Sun–Sat; the invoice goes out Saturday). Partial deposits are fine — rows for a week add up. A deposit that also pays OLD, non-claim items is split: record the claim part here, and the old-items part under its own customer (e.g. "PierLink — Prior Adjustments") — never inside a claim week. <b>Adjustment</b> records WHY part of a week's difference exists: enter the amount exactly as it appears in the difference (claimed − received) and a note; it never changes Listed/Received.</p>
</div>

<% if (!customer.invoice_linked) { %>
<div class="card">
  <h2>Add a claim week</h2>
  <form method="POST" action="/ar/claims" class="form-row" style="flex-wrap:wrap;gap:10px;align-items:end">
    <input type="hidden" name="customer_id" value="<%= customer.id %>">
    <div><label>Week ending (Sat)</label><input type="date" name="week_of" required value="<%= todayISO %>" data-week-sat="claimWeekSat"><div id="claimWeekSat" class="notice"></div></div>
    <div><label>Claimed amount $</label><input type="number" name="amount" step="0.01" min="0" required></div>
    <div><label>Note</label><input type="text" name="note"></div>
    <div><button type="submit">Add claim</button></div>
  </form>
</div>
<% } %>
<script>
// Display only: echo the Saturday of the picked week under the week
// fields above, so the reference day is never ambiguous. The value
// submitted is unchanged — the server still snaps it to the week's
// Sunday key for storage and matching, exactly as before.
(function () {
  function satISO(v) {
    var d = new Date(v + 'T00:00:00');
    if (isNaN(d)) return '';
    d.setDate(d.getDate() + (6 - d.getDay()));
    function p(n) { return (n < 10 ? '0' : '') + n; }
    return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate());
  }
  document.querySelectorAll('[data-week-sat]').forEach(function (inp) {
    var out = document.getElementById(inp.getAttribute('data-week-sat'));
    if (!out) return;
    function upd() { out.textContent = inp.value ? ('Week ending Sat ' + satISO(inp.value)) : ''; }
    inp.addEventListener('change', upd);
    inp.addEventListener('input', upd);
    upd();
  });
})();
</script>
<% } %>

<div class="card">
  <h2>List / deposit records</h2>
  <div class="table-wrap"><table>
    <tr><th>Date</th><th>For week ending (Sat)</th><th>Kind</th><th class="num">Amount</th><th>Method</th><th>Note</th><% if (canWrite) { %><th></th><% } %></tr>
    <% entries.forEach(function (e) { %>
    <tr>
      <td><%= e.entry_date %></td>
      <td><%= e.weekLabel %></td>
      <td><%= kindLabel(e.kind) %></td>
      <td class="num"><%= money(e.amount) %></td>
      <td><%= e.method || '' %></td>
      <td><%= e.note || '' %></td>
      <% if (canWrite) { %><td class="num"><form method="POST" action="/ar/entries/<%= e.id %>/delete" onsubmit="return confirm('Delete this record?')"><button class="btn secondary small" type="submit">Delete</button></form></td><% } %>
    </tr>
    <% }) %>
    <% if (!entries.length) { %><tr><td colspan="<%= canWrite ? 7 : 6 %>" class="notice">No records yet.</td></tr><% } %>
  </table></div>
</div>

<% if (!customer.invoice_linked && claims.length) { %>
<div class="card">
  <h2>Manual claim entries</h2>
  <div class="table-wrap"><table>
    <tr><th>Week ending (Sat)</th><th class="num">Amount</th><th>Note</th><% if (canWrite) { %><th></th><% } %></tr>
    <% claims.forEach(function (c) { %>
    <tr>
      <td><%= c.weekLabel %></td>
      <td class="num"><%= money(c.amount) %></td>
      <td><%= c.note || '' %></td>
      <% if (canWrite) { %><td class="num"><form method="POST" action="/ar/claims/<%= c.id %>/delete" onsubmit="return confirm('Delete this claim entry?')"><button class="btn secondary small" type="submit">Delete</button></form></td><% } %>
    </tr>
    <% }) %>
  </table></div>
</div>
<% } %>
<% } %>
<%- include('partials/footer') %>
