<%- include('partials/header', { title: 'Receipts' }) %>
<h1>Broker Receipts</h1>
<p class="notice">Record payments received from the broker (PierLink).</p>

<div class="card">
  <h2>Add receipt</h2>
  <form method="POST" action="/receipts">
    <div class="form-row">
      <div><label>Date</label><input type="date" name="receipt_date" required value="<%= new Date().toISOString().slice(0,10) %>"></div>
      <div><label>Amount ($)</label><input name="amount" type="number" step="0.01" required></div>
      <div><label>Payer</label><input name="payer" value="PierLink"></div>
      <div><label>Reference</label><input name="reference" placeholder="Statement number, etc."></div>
    </div>
    <div style="margin-top:12px"><button type="submit">Save receipt</button></div>
  </form>
</div>

<div class="card">
  <h2>Receipt list — Total: <%= money(total) %></h2>
  <form method="GET" action="/receipts">
    <div class="form-row">
      <div><label>From</label><input type="date" name="from" value="<%= filters.from %>"></div>
      <div><label>To</label><input type="date" name="to" value="<%= filters.to %>"></div>
    </div>
    <div style="margin-top:12px"><button type="submit">Filter</button></div>
  </form>
  <div class="table-wrap" style="margin-top:12px"><table>
    <tr><th>Date</th><th>Payer</th><th>Reference</th><th class="num">Amount</th><th></th></tr>
    <% receipts.forEach(function(r){ %>
    <tr>
      <td><%= fmtDate(r.receipt_date) %></td>
      <td><%= r.payer %></td>
      <td><%= r.reference || '' %></td>
      <td class="num"><%= money(r.amount) %></td>
      <td>
        <form class="inline" method="POST" action="/receipts/<%= r.id %>/delete" onsubmit="return confirm('Delete this record?')"><button class="btn small danger" type="submit">Delete</button></form>
      </td>
    </tr>
    <% }) %>
  </table></div>
  <% if (!receipts.length) { %><p class="notice">No receipts.</p><% } %>
</div>
<%- include('partials/footer') %>
