<%- include('partials/header', { title: 'Receipts' }) %>
<h1>입금 / Broker Receipts</h1>
<p class="notice">PierLink에서 받은 입금을 기록합니다. Record payments received from the broker (PierLink).</p>

<div class="card">
  <h2>입금 입력 / Add receipt</h2>
  <form method="POST" action="/receipts">
    <div class="form-row">
      <div><label>날짜 / Date</label><input type="date" name="receipt_date" required value="<%= new Date().toISOString().slice(0,10) %>"></div>
      <div><label>금액 / Amount ($)</label><input name="amount" type="number" step="0.01" required></div>
      <div><label>지불자 / Payer</label><input name="payer" value="PierLink"></div>
      <div><label>참조 / Reference</label><input name="reference" placeholder="정산서 번호 등"></div>
    </div>
    <div style="margin-top:12px"><button type="submit">저장 / Save receipt</button></div>
  </form>
</div>

<div class="card">
  <h2>입금 목록 / Receipt list — 합계 / Total: <%= money(total) %></h2>
  <form method="GET" action="/receipts">
    <div class="form-row">
      <div><label>부터 / From</label><input type="date" name="from" value="<%= filters.from %>"></div>
      <div><label>까지 / To</label><input type="date" name="to" value="<%= filters.to %>"></div>
    </div>
    <div style="margin-top:12px"><button type="submit">조회 / Filter</button></div>
  </form>
  <div class="table-wrap" style="margin-top:12px"><table>
    <tr><th>날짜</th><th>지불자</th><th>참조</th><th class="num">금액</th><th></th></tr>
    <% receipts.forEach(function(r){ %>
    <tr>
      <td><%= fmtDate(r.receipt_date) %></td>
      <td><%= r.payer %></td>
      <td><%= r.reference || '' %></td>
      <td class="num"><%= money(r.amount) %></td>
      <td>
        <form class="inline" method="POST" action="/receipts/<%= r.id %>/delete" onsubmit="return confirm('삭제할까요?')"><button class="btn small danger" type="submit">삭제</button></form>
      </td>
    </tr>
    <% }) %>
  </table></div>
  <% if (!receipts.length) { %><p class="notice">기록이 없습니다. No receipts.</p><% } %>
</div>
<%- include('partials/footer') %>
